---
import SiteLayout from '../layouts/SiteLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { homeFeaturedCaseStudies } from '../data/case-studies';
import { categories, products, company, productImageAlt } from '../data/site';

const heroImage = '/assets/commercial-inflatable-manufacturer-hero.webp';
const factoryImage = '/assets/optimized/home/factory-construction.webp';
const homeCategoryCardImageSlugs: Record<string, string> = {
  'bounce-house': 'palm-tree-bouncy-castle',
  'bounce-house-combo': 'dinosaur-bounce-house-slide-combo',
  'inflatable-slide': 'spider-man-inflatable-slide',
  'inflatable-water-park': 'outdoor-inflatable-water-park',
  'inflatable-water-slide': 'tropical-blow-up-water-slide',
};
const homeCategoryCards = Object.fromEntries(
  Object.entries(homeCategoryCardImageSlugs).map(([categorySlug, productSlug]) => {
    const product = products.find((item) => item.productSlug === productSlug);
    return [categorySlug, { image: product?.images[0], alt: product ? productImageAlt(product) : undefined }];
  }),
);
const featuredProductSlugs = [
  'bounce-house--commercial-grade-white-bounce-house-3',
  'bounce-house-combo--commercial-grade-bounce-house-and-slide-41',
  'inflatable-slide--inflatable-jungle-slide-15',
  'inflatable-obstacle-course--commercial-inflatable-obstacle-course-for-sale-9',
  'inflatable-games--commercial-inflatable-carnival-games-2',
  'inflatable-mechanical-games--commercial-mechanical-bull-for-sale-1',
  'bumper-ball--commercial-bumper-balls-17',
  'inflatable-tent--commercial-inflatable-black-honeycomb-tent-5',
  'advertising-inflatable--inflatable-logo-display-1',
  'inflatable-theme-park--adventure-play-inflatable-park-1',
  'inflatable-water-park--floating-island-inflatable-water-park-2',
  'inflatable-water-slide--shark-inflatable-water-slide-with-pool-20',
];
const featuredProducts = featuredProductSlugs
  .map((slug) => products.find((product) => product.slug === slug))
  .filter((product): product is (typeof products)[number] => Boolean(product));
const certificates = [
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-UL-certified.webp', preview: '/assets/optimized/home/certificate-ul.webp', name: 'UL document' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-ROHS-reach-compliance.webp', preview: '/assets/optimized/home/certificate-rohs-reach.webp', name: 'RoHS / REACH report' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-ISO25649-certificate.webp', preview: '/assets/optimized/home/certificate-iso25649.webp', name: 'ISO 25649 document' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-EN14960-certificate.webp', preview: '/assets/optimized/home/certificate-en14960.webp', name: 'EN 14960 document' },
];
const proofSteps = [
  { image: '/assets/optimized/home/process-design.webp', alt: 'Design drawing and 3D inflatable model reviewed before production', title: 'Requirements, design & approval', text: 'We confirm dimensions, layout, artwork, and key product details with you before production begins.' },
  { image: '/assets/optimized/home/process-material-cutting.webp', alt: 'PVC panels arranged for cutting to an approved inflatable pattern', title: 'Material and cutting', text: 'Materials are checked and cut against the approved production layout.' },
  { image: '/assets/optimized/home/process-sewing.webp', alt: 'Sewing machine joining reinforced fabric panels for an inflatable structure', title: 'Sewing and reinforcement', text: 'Seams and high-stress points are built for repeated commercial use.' },
  { image: '/assets/optimized/home/process-heat-sealing.webp', alt: 'Technician heat-sealing joined PVC panels on an inflatable product', title: 'Heat sealing', text: 'Selected product structures receive controlled heat-sealed splicing.' },
  { image: '/assets/optimized/home/process-inflation-test.webp', alt: 'Inflatable product fully inflated during a factory appearance and operation check', title: 'Inflation testing', text: 'Finished units are inflated to check appearance, seams, and operation.' },
  { image: '/assets/optimized/home/process-final-inspection.webp', alt: 'Completed inflatable inspected for finish and accessories before packing', title: 'Final inspection', text: 'Inspection points are completed before the product is packed for export.' },
  { image: '/assets/optimized/home/process-export-packing.webp', alt: 'Commercial inflatable folded and prepared for export shipment', title: 'Export packing', text: 'Packing and shipment details are prepared for your destination market.' },
];
const faqs = [
  { question: 'What kind of manufacturer is YIC Inflatable Sports?', answer: 'YIC Inflatable Sports is a factory-direct commercial inflatable manufacturer for importers, distributors, entertainment venues, resorts and event operators. Rental companies buy equipment from YIC as commercial fleet operators; YIC does not provide local consumer hire.' },
  { question: 'Can I order one commercial inflatable from YIC?', answer: 'Yes. The minimum order quantity is one unit. Send the product or reference image, quantity, destination and intended use so YIC can confirm the selected configuration and prepare a factory quotation.' },
  { question: 'Where can importers and distributors source commercial bounce houses?', answer: 'YIC manufactures commercial bounce houses for importers, distributors, family entertainment centers, venues and commercial fleet operators. Share the model or reference, quantity, destination and intended use to receive a quotation. The selected model specification confirms its material, construction, included accessories and applicable market documents.' },
  { question: 'How can buyers compare the quality of commercial inflatables?', answer: 'Compare the written specification for each model: material grade and weight, seams and reinforcement, anchoring points, compatible blower, included accessories, inspection scope and intended use. A general “commercial grade” label does not establish these details. Ask the manufacturer to confirm them for the selected model before ordering.' },
  { question: 'How long has YIC manufactured commercial inflatables?', answer: 'YIC has more than 15 years of manufacturing and export experience, with 116 long-term production professionals and customers in 57 countries.' },
  { question: 'Does YIC provide factory-direct OEM and ODM manufacturing?', answer: 'Yes. Buyers can bring an existing model or share a concept, reference image, dimensions, artwork, and intended use for an OEM or ODM project discussion with the factory.' },
  { question: 'How does YIC manage production quality?', answer: 'Order-linked checks can include material review, cutting, sewing and reinforcement, heat sealing where specified, inflation testing, final inspection, and export packing. The approved specification identifies the checkpoints applicable to the model.' },
  { question: 'Can YIC confirm product documents for my destination market?', answer: 'YIC reviews documentation against the specific product, components, and destination-market requirements. Certificate scope is checked for the requested model rather than assumed to apply universally.' },
  { question: 'Does YIC support international B2B customers?', answer: 'Yes. YIC supports international buyers with factory communication, production coordination, export packing, and shipment information for their destination.' },
];
const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `https://${company.domain}/#website`, name: 'YIC Inflatable Sports', url: `https://${company.domain}/`, publisher: { '@id': `https://${company.domain}/#organization` }, potentialAction: { '@type': 'SearchAction', target: `https://${company.domain}/search/?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
    { '@type': 'WebPage', '@id': `https://${company.domain}/#webpage`, name: 'Commercial Inflatable Manufacturer | YIC Inflatable Sports', url: `https://${company.domain}/`, isPartOf: { '@id': `https://${company.domain}/#website` }, about: { '@id': `https://${company.domain}/#organization` } },
  ],
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---

<SiteLayout title="Inflatable Sports Products Manufacturer | YIC" description="YIC manufactures commercial inflatable sports products, bounce houses, water slides, obstacle courses and games for importers and distributors. Factory-direct OEM/ODM; MOQ 1." image={heroImage} imageAlt="Commercial inflatable park with bounce houses, slides, and family entertainment attractions" keywords="inflatable sports products manufacturer, inflatable sports products factory, commercial inflatables wholesale, inflatable bounce house manufacturer, commercial inflatable water slides, inflatable obstacle course manufacturer, YIC Inflatable Sports">
  <section class="hero">
    <picture class="hero-media"><source media="(max-width: 700px)" srcset="/assets/optimized/home/hero-mobile.webp" type="image/webp" /><img src={heroImage} alt="Commercial inflatable park with bounce houses, slides, and family entertainment attractions" width="1365" height="768" fetchpriority="high" /></picture>
    <div class="container hero-content">
      <p class="eyebrow">Factory Direct · OEM &amp; ODM · Commercial Inflatables</p>
      <h1><span>Commercial Inflatable Manufacturer</span><span>for Importers, Distributors &amp;</span><span>Entertainment Venues</span></h1>
      <p>YIC Inflatable Sports manufactures commercial bounce houses, bounce house combos, inflatable slides, obstacle courses, water attractions, games, advertising inflatables, and custom inflatable solutions for importers, distributors, family entertainment centers, resorts, and event operators. Rental operators buy equipment from YIC as downstream commercial fleet buyers.</p>
      <p class="hero-supporting">Choose an existing design or send us your dimensions, artwork, reference image, and quantity. We coordinate design review, production, quality checks, export packing, and delivery planning.</p>
      <div class="hero-actions"><a class="button" href="/products/">Explore Commercial Inflatables</a><a class="button button-secondary" href="/contact/">Request a Factory Quote</a></div>
      <div class="hero-note"><span><i></i> 15+ years manufacturing experience</span><span><i></i> Product-specific material options</span><span><i></i> OEM/ODM · Global export support</span></div>
    </div>
  </section>

  <section class="stats" aria-label="YIC at a glance"><div class="container stats-inner"><div class="stat"><strong>15+</strong><span>Years manufacturing and export experience</span></div><div class="stat"><strong>116</strong><span>Long-term skilled production professionals</span></div><div class="stat"><strong>3,100+</strong><span>Commercial customers served</span></div><div class="stat"><strong>57</strong><span>Countries reached worldwide</span></div></div></section>

  <div class="home-page">
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Product range</p><h2>Commercial Inflatable Products for Global B2B Buyers</h2></div><p>Browse commercial inflatables across play, sports, event, advertising, and water applications. Importers, distributors, venues, resorts and commercial operators can discuss specifications, private label and OEM/ODM requirements directly with the factory. Rental businesses are served as equipment buyers, not as consumer-hire customers.</p></div><div class="category-grid">{categories.map((category) => <CategoryCard category={category} image={homeCategoryCards[category.slug]?.image} imageAlt={homeCategoryCards[category.slug]?.alt} />)}</div></div></section>

  <section class="section section-muted"><div class="container feature-grid"><div class="feature-image"><img src={factoryImage} alt="YIC commercial inflatable manufacturing workshop" loading="lazy" width="1200" height="900" /><div class="feature-tag"><strong>Commercial</strong><span>Product-specific materials, reinforced construction, and export-ready support</span></div></div><div class="feature-copy"><p class="eyebrow">Commercial-grade construction</p><h2>Commercial Inflatable Manufacturing for B2B Orders</h2><p>YIC manufactures commercial PVC inflatables for B2B importers and distributors. For applicable PVC products, raw material is sourced from Plato; material grade and construction are confirmed for each product's specification and intended commercial use.</p><ul class="check-list"><li>Plato PVC material for applicable products</li><li>Material specifications matched to product requirements</li><li>Reinforced high-stress points</li><li>OEM, ODM, and private-label customization</li><li>Inflation and appearance checks</li><li>Applicable specifications confirmed before production</li></ul><a class="text-link" href="/about/">See factory capability →</a></div></div></section>

  <section class="section why-section"><div class="container"><div class="section-heading why-header"><div><p class="eyebrow">Why YIC Inflatable Sports</p><h2>A factory partner with visible production checkpoints</h2></div><p>Choosing a factory is about more than a product photo. You need a clear route from requirements to approved artwork, production checks, packing, and a practical conversation when it is time to reorder.</p></div><div class="why-grid"><div class="why-visual"><div class="why-image-main"><img src="/assets/optimized/home/workshop-interior.webp" alt="YIC Inflatable Sports commercial inflatable manufacturing workshop interior" loading="lazy" width="1000" height="800" /></div><div class="why-visual-caption"><strong>One factory partner from design to delivery.</strong><span>Production support for importers, distributors, entertainment venues, event operators, and rental businesses.</span></div></div><div class="why-benefits"><article class="why-benefit"><span class="why-icon" aria-hidden="true">15+</span><div><h3>15+ years of manufacturing experience</h3><p>More than 15 years focused on commercial inflatables, OEM projects, and export orders.</p></div></article><article class="why-benefit"><span class="why-icon" aria-hidden="true">✓</span><div><h3>Quality checkpoints you can understand</h3><p>Material, sewing, reinforcement, inflation, appearance, and packing checks keep each order accountable.</p></div></article><article class="why-benefit"><span class="why-icon" aria-hidden="true">◎</span><div><h3>3,100+ customers in 57 countries</h3><p>A global customer base gives us practical experience with different venues, markets, and shipping requirements.</p></div></article><article class="why-benefit"><span class="why-icon" aria-hidden="true">3D</span><div><h3>Design approval before production</h3><p>Share a sketch, logo, theme, or dimensions. We review the layout, artwork, and key details with you before production starts.</p></div></article><article class="why-benefit"><span class="why-icon" aria-hidden="true">OEM</span><div><h3>Factory-direct OEM and ODM</h3><p>Work directly with the manufacturing team for custom colors, artwork, layouts, dimensions, and product concepts.</p></div></article><article class="why-benefit"><span class="why-icon" aria-hidden="true">PVC</span><div><h3>Plato PVC material for applicable products</h3><p>For applicable products, PVC raw material is sourced from Plato; grade and construction are matched to the intended use and product requirements.</p></div></article><article class="why-benefit"><span class="why-icon" aria-hidden="true">→</span><div><h3>Clear production and delivery coordination</h3><p>We confirm specifications, inspection details, packing, and destination requirements before shipment.</p></div></article><article class="why-benefit"><span class="why-icon" aria-hidden="true">↻</span><div><h3>Support built for repeat orders</h3><p>Keep communication simple from the first quotation through future replenishment and new custom projects.</p></div></article></div></div></div></section>

  <section class="section section-muted"><div class="container oem-grid"><div><p class="eyebrow">Custom inflatable OEM / ODM</p><h2>Custom Inflatable OEM &amp; ODM Manufacturing</h2><p>Give us your reference image, logo, dimensions, quantity, intended use, and destination market. We turn those details into a practical design and manufacturing discussion before the order moves forward.</p><a class="button" href="/contact/">Start a custom project</a></div><div class="oem-steps" aria-label="Custom inflatable OEM and ODM process"><div><strong>01</strong><span>Share your idea, reference, logo, quantity, and market</span></div><div><strong>02</strong><span>Review design, material, size, and product details</span></div><div><strong>03</strong><span>Approve artwork and specification before production</span></div><div><strong>04</strong><span>Manufacture with defined production and QC checkpoints</span></div><div><strong>05</strong><span>Confirm packing and shipment details for your destination</span></div></div></div></section>

  <section class="section"><div class="container"><div class="section-heading process-heading"><div><p class="eyebrow">Production process</p><h2>Commercial Inflatable Manufacturing &amp; Quality Control</h2></div><p>From your approved design to export packing, defined checkpoints keep materials, reinforced workmanship, inflation performance, and shipment readiness aligned before your order leaves the factory.</p></div><div class="proof-grid">{proofSteps.map((step, index) => <article class="proof-item"><img src={step.image} alt={step.alt} loading="lazy" width="900" height="675" /><div><strong>0{index + 1}</strong><h3>{step.title}</h3><p>{step.text}</p></div></article>)}</div></div></section>

  <section class="section section-muted"><div class="container"><div class="section-heading"><div><p class="eyebrow">Project examples</p><h2>Commercial Inflatable Projects in the United States and Europe</h2></div><p>Selected project images from the United States, Germany, and France show commercial inflatables for sports, recreation, and water-park applications. Browse the full project gallery for examples from additional markets.</p><a class="text-link" href="/case-studies/">View all project examples →</a></div><div class="case-preview-grid">{homeFeaturedCaseStudies.map((caseStudy) => <article class="case-preview-card"><img src={caseStudy.image} alt={caseStudy.alt} loading="lazy" width="960" height="720" /><div><p>{caseStudy.country}</p><h3>{caseStudy.title}</h3><span>{caseStudy.productType}</span></div></article>)}</div></div></section>

  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Selected products</p><h2>Featured commercial inflatables for B2B buyers</h2></div><a class="text-link" href="/products/">View all products →</a></div><div class="product-grid">{featuredProducts.map((product) => <ProductCard product={product} variant="selector" />)}</div></div></section>

  <section class="section section-muted"><div class="container"><div class="section-heading"><div><p class="eyebrow">Commercial use cases</p><h2>Commercial Inflatables for Different Business Applications</h2></div><p>Build a commercial product range for distribution, a family entertainment offer, a resort attraction, a branded event setup, or an operating fleet. YIC supports specification and OEM/ODM discussions directly with the factory.</p></div><div class="use-case-grid"><a href="/products/bounce-house/"><h3>Fleet operators</h3><span>Bounce houses, combos, slides, and repeat-order equipment support.</span></a><a href="/products/inflatable-theme-park/"><h3>Family entertainment centers</h3><span>Themed play attractions and interactive games for busy venues.</span></a><a href="/products/inflatable-water-park/"><h3>Water parks and resorts</h3><span>Commercial water attractions for recreation operators.</span></a><a href="/products/advertising-inflatable/"><h3>Events and brand activations</h3><span>Branded inflatables, tents, displays, and promotional spaces.</span></a></div></div></section>

  <section class="section exhibition-section"><div class="container"><div class="exhibition-feature-grid"><figure class="exhibition-figure"><img class="exhibition-image" src="/assets/optimized/home/exhibition.webp" alt="YIC Inflatable Sports commercial inflatables displayed at international exhibitions with global buyers and factory partners" loading="lazy" width="1100" height="589" /><figcaption>Real conversations with customers and partners at our factory and international exhibitions.</figcaption></figure><div class="feature-copy"><p class="eyebrow">Exhibitions &amp; factory visits</p><h2>Trusted by Global Partners Worldwide</h2><p>We regularly showcase our latest commercial bounce houses, water slides, and custom inflatables at major international trade shows. Connect with our expert team on-site, check product quality firsthand, and discover how we bring your custom designs to life.</p><a class="text-link" href="/contact/">Discuss your project with YIC →</a></div></div><div class="exhibition-proof-grid"><article class="exhibition-proof-card"><span class="exhibition-proof-icon" aria-hidden="true">◎</span><div><h3>Global Customers</h3><p>Trusted by buyers in 57 countries worldwide.</p></div></article><article class="exhibition-proof-card"><span class="exhibition-proof-icon" aria-hidden="true">✦</span><div><h3>Exhibition Experience</h3><p>Participating in global exhibitions and industry events.</p></div></article><article class="exhibition-proof-card"><span class="exhibition-proof-icon" aria-hidden="true">↔</span><div><h3>Face-to-Face Communication</h3><p>Building long-term partnerships through direct communication.</p></div></article><article class="exhibition-proof-card"><span class="exhibition-proof-icon" aria-hidden="true">✓</span><div><h3>Quality &amp; Trust</h3><p>Commercial products, clear inspection steps, and responsive factory support.</p></div></article></div></div></section>

  <section class="section"><div class="container"><div class="section-heading certificate-heading"><div><p class="eyebrow">Certifications &amp; compliance</p><h2>Commercial Inflatable Compliance &amp; Documentation</h2></div><p>Documentation must match the specific product, component, and destination market. Before ordering, ask YIC to confirm the applicable certificates, test reports, and supporting files for your requested model.</p></div><div class="certificate-grid">{certificates.map((certificate) => <figure><a class="certificate-link" href={certificate.image} target="_blank" rel="noopener" aria-label={`Open ${certificate.name} document in a new tab`}><img src={certificate.preview} alt={certificate.name === 'RoHS / REACH report' ? 'RoHS and REACH chemical compliance test report' : `${certificate.name} for an inflatable product component or material`} loading="lazy" width="400" height="533" /></a><figcaption><strong>{certificate.name}</strong><span>Open full document ↗</span></figcaption></figure>)}</div><a class="text-link section-link" href="/about/">View factory and compliance information →</a></div></section>

  <section class="section section-muted"><div class="container"><div class="section-heading"><div><p class="eyebrow">Buyer resources</p><h2>Useful starting points for your next order</h2></div><p>Move from product discovery to a clear factory conversation with practical buying, sourcing, material, and export guidance.</p></div><div class="resource-grid"><a href="/products/"><strong>Product catalog</strong><span>Compare categories, models, photos, and product specifications.</span></a><a href="/about/"><strong>Factory and quality</strong><span>Review manufacturing capability, inspection, and compliance information.</span></a><a href="/blog/"><strong>Buying guides</strong><span>Explore commercial inflatable sourcing, OEM, material, safety, and rental planning guides.</span></a><a href="/contact/"><strong>RFQ checklist</strong><span>Send your product, quantity, market, branding, and delivery requirements.</span></a></div></div></section>

  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Manufacturer questions</p><h2>YIC Manufacturer &amp; Factory FAQ</h2></div><a class="text-link" href="/faq/">View all buyer FAQs →</a></div><div class="faq-list">{faqs.map((faq) => <article class="faq-item"><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div></div></section>

  <section class="cta-band"><div class="container cta-band-inner"><div><p class="eyebrow">Factory quotation</p><h2>Need a quote for commercial inflatables?</h2><p>Send us your product list, target quantity, dimensions, branding, or custom requirements.</p></div><div class="hero-actions"><a class="button button-secondary" href="/contact/">Request a factory quote</a><a class="button button-secondary" href={`https://wa.me/${company.whatsapp}?text=${encodeURIComponent(`Hello YIC, I would like a quotation. Page URL: https://${company.domain}/`)}`} target="_blank" rel="noopener">WhatsApp the factory</a></div></div></section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(homeSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</SiteLayout>
