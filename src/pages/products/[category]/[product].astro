---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { products, company, productAbsoluteUrl, productBatch, productCategoryTemplate, productDescription, productDetailContent, productDisplayTitle, productFaqs, productKeyFeatures, productKeywordVariants, productPath, productSeoKeywords, productSeoTitle, productMetaDescription, productTargetBuyers } from '../../../data/site';
import type { Product } from '../../../data/site';

export function getStaticPaths() {
  return products.map((product) => ({ params: { category: product.categorySlug, product: product.productSlug }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
const displayTitle = productDisplayTitle(product);
const detail = productDetailContent(product);
const categoryTemplate = productCategoryTemplate(product);
const batchTemplate = productBatch(product);
const description = productDescription(product);
const metaDescription = productMetaDescription(product);
const faqs = productFaqs(product);
const keyFeatures = productKeyFeatures(product);
const targetBuyers = productTargetBuyers(product);
const keywordVariants = productKeywordVariants(product);
const relatedProducts = products.filter((item) => item.categorySlug === product.categorySlug && item.slug !== product.slug).slice(0, 4);
const imageAlt = `${displayTitle}, a commercial ${detail.productType} by YIC Inflatable Sports`;
const seoKeywords = productSeoKeywords(product);
const accessoryLabel = /0\.55\s*mm/i.test(product.material) ? 'Blower / Repair Kits / Carry Bag' : 'Pump / Repair Kits / Carry Bag';
const templateLabels = {
  specification: { eyebrow: 'Commercial specification', heading: `Plan ${displayTitle} with the right details`, text: 'Use the reference specification as a starting point, then confirm the final production details for your market and operating plan.' },
  application: { eyebrow: 'Commercial applications', heading: `Where ${displayTitle} creates value`, text: 'A product choice works best when the attraction, venue, guest flow, and operating plan are considered together.' },
  'custom-project': { eyebrow: 'Custom project planning', heading: `Make ${displayTitle} fit your market`, text: 'Start with your commercial goal, then align the visual design, layout, functional details, and delivery requirements before production.' },
}[detail.template];
const pageUrl = productAbsoluteUrl(product);
const schema = {
  '@context': 'https://schema.org', '@type': 'Product', '@id': `${pageUrl}#product`,
  name: displayTitle, category: product.category, url: pageUrl, sku: product.slug, keywords: seoKeywords,
  image: product.images.map((image) => new URL(image, `https://${company.domain}`).href), description,
  brand: { '@type': 'Brand', name: 'YIC Inflatable Sports' }, manufacturer: { '@id': `https://${company.domain}/#organization` },
  audience: { '@type': 'Audience', audienceType: detail.primaryBuyer },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Reference dimensions', value: product.dimensions || 'Custom dimensions available' },
    { '@type': 'PropertyValue', name: 'Material', value: product.material },
    { '@type': 'PropertyValue', name: 'Customization', value: 'OEM / ODM artwork, colors, layout, and dimensions available' },
    { '@type': 'PropertyValue', name: 'Warranty', value: '3 years' },
    { '@type': 'PropertyValue', name: 'Accessories', value: accessoryLabel },
    { '@type': 'PropertyValue', name: 'Applications', value: detail.applications.map((item) => item.title).join(', ') },
    { '@type': 'PropertyValue', name: 'Target buyers', value: detail.primaryBuyer },
    { '@type': 'PropertyValue', name: 'Production', value: 'Factory direct production with artwork approval, inspection, export packing, and global delivery coordination' },
    { '@type': 'PropertyValue', name: 'Related search terms', value: keywordVariants.slice(0, 10).join(', ') },
  ],
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${company.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `https://${company.domain}/products/` },
    { '@type': 'ListItem', position: 3, name: product.category, item: `https://${company.domain}/products/${product.categorySlug}/` },
    { '@type': 'ListItem', position: 4, name: displayTitle },
  ],
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---

<SiteLayout title={productSeoTitle(product)} description={metaDescription} image={product.images[0]} imageAlt={imageAlt} keywords={seoKeywords}>
  <article class:list={['product-detail-page', `product-template-${detail.template}`, `category-template-${categoryTemplate}`, `batch-template-${batchTemplate}`]}>
    <section class="detail-wrap"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/products/">Products</a> / <a href={`/products/${product.categorySlug}/`}>{product.category}</a> / {displayTitle}</div><div class="detail-grid">
      <div class="detail-gallery" data-gallery>
        <img class="detail-main-image" data-main-image src={product.images[0]} alt={imageAlt} title={imageAlt} width="1200" height="900" fetchpriority="high" decoding="async" />
        <div class="detail-thumbs">{product.images.map((image, index) => <button class:list:active={index === 0} type="button" data-image={image} aria-label={`View ${displayTitle} photo ${index + 1}`}><img src={image} alt={`${displayTitle} product photo ${index + 1}`} title={`${displayTitle} product photo ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" width="240" height="180" /></button>)}</div>
      </div>
      <div class="detail-copy">
        <p class="eyebrow">{product.category} · Custom OEM/ODM manufacturer · Factory direct</p>
        <h1>{displayTitle}</h1>
        <p>{description}</p>
        <div class="detail-meta"><div><span>Material</span><strong>{product.material}</strong></div><div><span>Best for</span><strong>{detail.primaryBuyer}</strong></div><div><span>Reference size</span><strong>{product.dimensions || 'Custom dimensions available'}</strong></div><div><span>Customization</span><strong>OEM / ODM supported</strong></div><div><span>Warranty</span><strong>3 years</strong></div><div><span>Accessories</span><strong>{accessoryLabel}</strong></div></div>
        <div class="detail-actions"><a class="button" href={`/contact/?product=${encodeURIComponent(displayTitle)}&source=${encodeURIComponent(pageUrl)}`}>Request a quote</a><a class="button button-secondary" href={`https://wa.me/${company.whatsapp}?text=${encodeURIComponent(`Hello YIC, I would like a quotation for ${displayTitle}. Product URL: ${pageUrl}. Please confirm specifications, customization options, lead time, and shipping details.`)}`} target="_blank" rel="noopener">WhatsApp us</a></div>
        <div class="detail-trust"><div><strong>Factory direct</strong><span>From specification to export packing</span></div><div><strong>Custom project</strong><span>Artwork, layout, colors, and size options</span></div><div><strong>Buyer focused</strong><span>Built around your market and venue</span></div></div>
      </div>
    </div></div></section>

    <section class="detail-section section-muted product-features-section"><div class="container"><div class="detail-template-heading"><p class="eyebrow">Product overview</p><h2>Why {displayTitle} works for commercial buyers</h2><p>{detail.purpose} Review the product-specific features below with your venue, guest flow, branding brief, and repeat-use plan in mind.</p></div><div class="detail-feature-grid">{keyFeatures.map((feature, index) => <article><span>0{index + 1}</span><strong>{feature}</strong></article>)}</div></div></section>

    <section class="detail-section product-commercial-section"><div class="container"><div class="detail-template-heading"><p class="eyebrow">Commercial product information</p><h2>Specifications, applications, and buyer fit</h2><p>Use these details to prepare a practical RFQ. Final construction, accessories, documentation, and delivery terms are confirmed against your destination market and order brief.</p></div><div class="detail-commercial-grid"><div class="detail-spec-list"><div><span>Product type</span><strong>{detail.productType}</strong></div><div><span>Category</span><strong>{product.category}</strong></div><div><span>Reference size</span><strong>{product.dimensions || 'Custom dimensions available'}</strong></div><div><span>Material</span><strong>{product.material}</strong></div><div><span>Custom printing</span><strong>Logo, artwork, and brand colors</strong></div><div><span>OEM / ODM</span><strong>Custom size, structure, and layout supported</strong></div></div><div class="detail-buyer-panel"><h3>Applications and target buyers</h3><div class="detail-application-list">{detail.applications.map((application) => <article><h4>{application.title}</h4><p>{application.text}</p></article>)}</div><div class="detail-buyer-tags">{targetBuyers.map((buyer) => <span>{buyer}</span>)}</div></div></div></div></section>

    {detail.template === 'specification' && <section class="detail-section detail-template-section"><div class="container"><div class="category-intro"><div><p class="eyebrow">Commercial specification</p><h2>Everything a buyer needs before ordering</h2></div><p>We confirm construction, dimensions, artwork, packing, and delivery information with you before production starts.</p></div><div class="process-grid"><div class="process-step"><strong>01 / SPECIFICATION</strong><h3>{product.material}</h3><p>Reference size: {product.dimensions || 'Made to your required dimensions'}.</p></div><div class="process-step"><strong>02 / DESIGN</strong><h3>Brand-ready artwork</h3><p>Send your logo, colors, and theme. We return a production layout for approval.</p></div><div class="process-step"><strong>03 / INSPECTION</strong><h3>Inflation testing</h3><p>Finished units are checked for appearance, seams, inflation, and packing details.</p></div><div class="process-step"><strong>04 / DELIVERY</strong><h3>Export coordination</h3><p>We share packing details and delivery communication for your destination.</p></div></div><div class="buyer-grid"><div class="buyer-panel"><h3>What can be customized</h3><ul><li>Logo, colors, characters, and printed artwork</li><li>Overall dimensions and layout for your venue</li><li>Entrance, slide, game, or branding details</li><li>Packaging, accessories, and spare parts</li></ul></div><div class="buyer-panel"><h3>Send these details for a quote</h3><ul><li>Model name and estimated quantity</li><li>Destination country and delivery city</li><li>Preferred size, colors, and artwork</li><li>Target delivery date and application</li></ul></div></div></div></section>}

    {detail.template === 'application' && <section class="detail-section section-muted detail-template-section"><div class="container"><div class="detail-template-heading"><p class="eyebrow">{templateLabels.eyebrow}</p><h2>{templateLabels.heading}</h2><p>{templateLabels.text}</p></div><div class="detail-application-grid">{detail.applications.map((application, index) => <article><span>0{index + 1}</span><h3>{application.title}</h3><p>{application.text}</p></article>)}</div><div class="detail-note"><strong>Operational planning</strong><p>{detail.operationNote}</p></div></div></section>}

    {detail.template === 'custom-project' && <section class="detail-section detail-template-section"><div class="container"><div class="detail-template-heading"><p class="eyebrow">{templateLabels.eyebrow}</p><h2>{templateLabels.heading}</h2><p>{templateLabels.text}</p></div><div class="detail-custom-grid"><div class="detail-custom-copy"><h3>Customization options</h3><ul>{detail.customization.map((item) => <li>{item}</li>)}</ul></div><div class="detail-custom-copy detail-custom-dark"><h3>Start with the project brief</h3><ul>{detail.quoteItems.map((item) => <li>{item}</li>)}</ul></div></div><div class="detail-project-flow"><span>Brief</span><span>Artwork review</span><span>Specification confirmation</span><span>Production</span><span>Inspection &amp; packing</span></div></div></section>}

    <section class="detail-section"><div class="container"><div class="buyer-grid"><div class="buyer-panel"><p class="eyebrow">Buyer checklist</p><h3>What to confirm before production</h3><ul>{detail.planningPoints.map((item) => <li>{item}</li>)}</ul></div><div class="buyer-panel"><p class="eyebrow">Factory support</p><h3>What YIC can review with you</h3><ul><li>Product specification, dimensions, and operating purpose</li><li>Artwork, colors, branding, and functional changes</li><li>Production timing, packing, accessories, and shipping details</li><li>Applicable documentation for the requested product and market</li></ul></div></div></div></section>

    <section class="detail-section section-muted product-proof-section"><div class="container"><div class="detail-template-heading"><p class="eyebrow">Factory proof</p><h2>Why source this product from YIC?</h2><p>YIC connects product-specific design support with repeatable production, inspection, export packing, and communication for international buyers.</p></div><div class="detail-proof-grid"><article><strong>15+ years</strong><span>Manufacturing and export experience</span></article><article><strong>Artwork approval</strong><span>Review the visual and structural brief before production</span></article><article><strong>Multi-stage QC</strong><span>Material, construction, inflation or operation checks</span></article><article><strong>OEM / ODM</strong><span>Custom colors, dimensions, layouts, and branding</span></article><article><strong>Global delivery</strong><span>Packing and destination coordination for repeat orders</span></article></div></div></section>

    <section class="detail-section section-muted"><div class="container"><div class="detail-template-heading"><p class="eyebrow">Buyer questions</p><h2>{displayTitle} FAQ</h2><p>Six product-specific questions covering specifications, applications, customization, quality, delivery, and commercial planning.</p></div><div class="faq-list">{faqs.map((faq) => <article class="faq-item"><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}</div></div></section>
    {relatedProducts.length > 0 && <section class="section related-products"><div class="container"><div class="section-heading"><div><p class="eyebrow">More from this category</p><h2>Compare related {product.category} models</h2></div><a class="text-link" href={`/products/${product.categorySlug}/`}>View all {product.category} →</a></div><div class="product-grid">{relatedProducts.map((item) => <ProductCard product={item} />)}</div></div></section>}
    <section class="cta-band"><div class="container cta-band-inner"><div><p class="eyebrow">Factory quotation</p><h2>Need {displayTitle} for your market?</h2><p>Send YIC your quantity, destination, product requirements, and branding brief for a practical factory quotation.</p></div><a class="button button-secondary" href={`/contact/?product=${encodeURIComponent(displayTitle)}&source=${encodeURIComponent(pageUrl)}`}>Talk to the factory</a></div></section>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script>
    const gallery = document.querySelector('[data-gallery]');
    const mainImage = gallery?.querySelector('[data-main-image]');
    gallery?.querySelectorAll('button[data-image]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!mainImage) return;
        mainImage.src = button.dataset.image ?? mainImage.src;
        gallery.querySelectorAll('button[data-image]').forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
      });
    });
  </script>
</SiteLayout>
