---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { products, company, categoryPath, publicCategorySlug, productAbsoluteUrl, productBatch, productCategoryTemplate, productDescription, productDetailContent, productHeadingTitle, productFaqs, productKeyFeatures, productKeywordVariants, productPrimaryKeyword, productRelatedProducts, productSeoKeywords, productSeoTitle, productMetaDescription, productTargetBuyers } from '../../../data/site';
import type { Product } from '../../../data/site';

export function getStaticPaths() {
  return products.map((product) => ({ params: { category: publicCategorySlug(product.categorySlug), product: product.productSlug }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
const displayTitle = productHeadingTitle(product);
const headingTitle = displayTitle;
const detail = productDetailContent(product);
const categoryTemplate = productCategoryTemplate(product);
const batchTemplate = productBatch(product);
const description = productDescription(product);
const metaDescription = productMetaDescription(product);
const faqs = productFaqs(product);
const keyFeatures = productKeyFeatures(product);
const targetBuyers = productTargetBuyers(product);
const keywordVariants = productKeywordVariants(product);
const primaryKeyword = productPrimaryKeyword(product);
const normalizedPrimaryKeyword = primaryKeyword.toLowerCase().replace(/\s+/g, ' ').trim();
const relatedBuyerSearches = keywordVariants
  .filter((term) => term.toLowerCase().replace(/\s+/g, ' ').trim() !== normalizedPrimaryKeyword)
  .slice(0, 4);
const relatedProducts = productRelatedProducts(product);
const imageAlt = `${headingTitle}, a commercial ${detail.productType} by YIC Inflatable Sports`;
const seoKeywords = productSeoKeywords(product);
const accessoryLabel = /0\.55\s*mm/i.test(product.material) ? 'Blower / Repair Kits / Carry Bag' : 'Pump / Repair Kits / Carry Bag';
const templateLabels = {
  specification: { eyebrow: 'Commercial specification', heading: `Plan ${displayTitle} with the right details`, text: 'Use the reference specification as a starting point, then confirm the final production details for your market and operating plan.' },
  application: { eyebrow: 'Commercial applications', heading: `Where ${displayTitle} creates value`, text: 'A product choice works best when the attraction, venue, guest flow, and operating plan are considered together.' },
  'custom-project': { eyebrow: 'Custom project planning', heading: `Make ${displayTitle} fit your market`, text: 'Start with your commercial goal, then align the visual design, layout, functional details, and delivery requirements before production.' },
}[detail.template];
const pageUrl = productAbsoluteUrl(product);
const buyerGuides: Record<string, { href: string; label: string }> = {
  'Bounce House': { href: '/blog/commercial-vs-residential-bounce-houses/', label: 'Read the commercial bounce house buying guide' },
  'Bounce House Combo': { href: '/blog/commercial-vs-residential-bounce-houses/', label: 'Read the commercial bounce house buying guide' },
  'Bumper Ball': { href: '/blog/inflatable-games-for-family-entertainment-centers/', label: 'Read the interactive inflatable game buying guide' },
  'Inflatable Games': { href: '/blog/inflatable-games-for-family-entertainment-centers/', label: 'Read the interactive inflatable game buying guide' },
  'Inflatable Mechanical Games': { href: '/blog/inflatable-games-for-family-entertainment-centers/', label: 'Read the interactive inflatable game buying guide' },
  'Inflatable Obstacle Course': { href: '/blog/inflatable-obstacle-course-design-guide/', label: 'Read the commercial obstacle-course buying guide' },
  'Inflatable Slide': { href: '/blog/commercial-inflatable-slide-buying-guide/', label: 'Read the commercial inflatable slide buying guide' },
  'Inflatable Water Slide': { href: '/blog/commercial-inflatable-slide-buying-guide/', label: 'Read the commercial inflatable slide buying guide' },
  'Inflatable Water Park': { href: '/blog/how-to-plan-an-inflatable-water-park/', label: 'Read the inflatable water park planning guide' },
  'Inflatable Tent': { href: '/blog/commercial-pvc-thickness-guide/', label: 'Read the commercial PVC material guide' },
  'Inflatable Theme Park': { href: '/blog/how-to-choose-commercial-inflatable-manufacturer/', label: 'Read the commercial inflatable sourcing guide' },
  'Advertising Inflatable': { href: '/blog/custom-branded-inflatable-tent/', label: 'Read the custom branded inflatable guide' },
};
const buyerGuide = buyerGuides[product.category] ?? { href: '/blog/how-to-choose-commercial-inflatable-manufacturer/', label: 'Read the commercial inflatable sourcing guide' };
const procurementGuide = { href: '/blog/inflatable-rfq-checklist-for-factory-quotation/', label: 'Open the factory RFQ checklist' };
const schema = {
  '@context': 'https://schema.org', '@type': 'Product', '@id': `${pageUrl}#product`,
  name: headingTitle, category: product.category, url: pageUrl, sku: product.slug, keywords: seoKeywords,
  image: product.images.map((image) => new URL(image, `https://${company.domain}`).href), description,
  brand: { '@type': 'Brand', name: 'YIC Inflatable Sports' }, manufacturer: { '@id': `https://${company.domain}/#organization` },
  audience: { '@type': 'Audience', audienceType: detail.primaryBuyer },
  isRelatedTo: [
    { '@type': 'WebPage', name: `${product.category} product category`, url: `https://${company.domain}${categoryPath(product.categorySlug)}` },
    { '@type': 'Article', name: buyerGuide.label, url: `https://${company.domain}${buyerGuide.href}` },
    { '@type': 'Article', name: procurementGuide.label, url: `https://${company.domain}${procurementGuide.href}` },
  ],
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Reference dimensions', value: product.dimensions || 'Custom dimensions available' },
    { '@type': 'PropertyValue', name: 'Material', value: product.material },
    { '@type': 'PropertyValue', name: 'Customization', value: 'OEM / ODM artwork, colors, layout, and dimensions available' },
    { '@type': 'PropertyValue', name: 'Warranty', value: '3 years' },
    { '@type': 'PropertyValue', name: 'Accessories', value: accessoryLabel },
    { '@type': 'PropertyValue', name: 'Lead time', value: '7-10 Work Days' },
    { '@type': 'PropertyValue', name: 'Compliance', value: 'EN14960 / ASTM / CE / NFPA 701' },
    { '@type': 'PropertyValue', name: 'Applications', value: detail.applications.map((item) => item.title).join(', ') },
    { '@type': 'PropertyValue', name: 'Target buyers', value: detail.primaryBuyer },
    { '@type': 'PropertyValue', name: 'Customization scope', value: detail.customization.join('; ') },
    { '@type': 'PropertyValue', name: 'Quotation checklist', value: detail.quoteItems.join('; ') },
    { '@type': 'PropertyValue', name: 'Production', value: 'Factory direct production with artwork approval, inspection, export packing, and global delivery coordination' },
    { '@type': 'PropertyValue', name: 'Related search terms', value: keywordVariants.slice(0, 10).join(', ') },
  ],
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${company.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `https://${company.domain}/products/` },
    { '@type': 'ListItem', position: 3, name: product.category, item: `https://${company.domain}${categoryPath(product.categorySlug)}` },
    { '@type': 'ListItem', position: 4, name: displayTitle },
  ],
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---

<SiteLayout title={productSeoTitle(product)} description={metaDescription} image={product.images[0]} imageAlt={imageAlt} keywords={seoKeywords}>
  <article class:list={['product-detail-page', `product-template-${detail.template}`, `category-template-${categoryTemplate}`, `batch-template-${batchTemplate}`]}>
    <section class="detail-wrap"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/products/">Products</a> / <a href={categoryPath(product.categorySlug)}>{product.category}</a> / {displayTitle}</div><div class="detail-grid">
      <div class="detail-gallery" data-gallery>
        <div class="detail-main-frame">
          <img class="detail-main-image" data-main-image src={product.images[0]} alt={imageAlt} title={imageAlt} width="1200" height="900" fetchpriority="high" decoding="async" />
          <span class="detail-certification-badge" aria-label="EN14960, ASTM, and CE information">EN14960 / ASTM / CE</span>
        </div>
        <div class="detail-thumbs">{product.images.map((image, index) => <button class:list:active={index === 0} type="button" data-image={image} aria-label={`View ${headingTitle} photo ${index + 1}`}><img src={image} alt={`${headingTitle} product photo ${index + 1}`} title={`${headingTitle} product photo ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" width="240" height="180" /></button>)}</div>
      </div>
      <div class="detail-copy">
        <p class="eyebrow">{product.category} · Custom OEM/ODM manufacturer · Factory direct</p>
        <h1>{headingTitle}</h1>
        <p>{description}</p>
        <div class="detail-meta"><div><span>Material</span><strong>{product.material}</strong></div><div><span>Best for</span><strong>{detail.primaryBuyer}</strong></div><div><span>Reference size</span><strong>{product.dimensions || 'Custom dimensions available'}</strong></div><div><span>Customization</span><strong>OEM / ODM supported</strong></div><div><span>Warranty</span><strong>3 years</strong></div><div><span>Accessories</span><strong>{accessoryLabel}</strong></div><div><span>Lead Time</span><strong>7-10 Work Days</strong></div><div><span>Compliance</span><strong>EN14960 / ASTM / CE / NFPA 701</strong></div></div>
        <div class="detail-actions"><a class="button" href={`/contact/?product=${encodeURIComponent(displayTitle)}&source=${encodeURIComponent(pageUrl)}`}>Request a quote</a><a class="button button-secondary" href={`https://wa.me/${company.whatsapp}?text=${encodeURIComponent(`Hello YIC, I would like a quotation for ${displayTitle}. Product URL: ${pageUrl}. Please confirm specifications, customization options, lead time, and shipping details.`)}`} target="_blank" rel="noopener">WhatsApp us</a></div>
        <div class="detail-trust"><div><strong>Factory direct</strong><span>From specification to export packing</span></div><div><strong>Custom project</strong><span>Artwork, layout, colors, and size options</span></div><div><strong>Buyer focused</strong><span>Built around your market and venue</span></div></div>
      </div>
    </div></div></section>

    <section class="detail-section section-muted product-features-section"><div class="container"><div class="detail-template-heading"><p class="eyebrow">Product overview</p><h2>Why {displayTitle} works for commercial buyers</h2><p>{detail.purpose} Review the product-specific features below with your venue, guest flow, branding brief, and repeat-use plan in mind.</p></div><div class="detail-feature-grid">{keyFeatures.map((feature, index) => <article><span>0{index + 1}</span><strong>{feature}</strong></article>)}</div></div></section>

    {detail.template === 'specification' && <section class="detail-section detail-template-section product-spec-planning"><div class="container"><div class="category-intro"><div><p class="eyebrow">Specification &amp; site planning</p><h2>Plan the setup around the product</h2></div><p>Use this model-specific checklist to prepare the site and confirm the final production brief. The dimensions and material are listed above.</p></div><div class="product-planning-grid">{detail.planningPoints.map((item, index) => <article><span>0{index + 1}</span><p>{item}</p></article>)}</div><div class="detail-note"><strong>Before production</strong><p>{detail.operationNote}</p></div></div></section>}

    {detail.template === 'application' && <section class="detail-section section-muted detail-template-section product-application-planning"><div class="container"><div class="detail-template-heading"><p class="eyebrow">{templateLabels.eyebrow}</p><h2>{templateLabels.heading}</h2><p>{templateLabels.text}</p></div><div class="detail-application-grid">{detail.applications.map((application, index) => <article><span>0{index + 1}</span><h3>{application.title}</h3><p>{application.text}</p></article>)}</div><div class="product-buyer-fit"><strong>Typical buyers</strong><div class="detail-buyer-tags">{targetBuyers.map((buyer) => <span>{buyer}</span>)}</div></div><div class="detail-note"><strong>Operational planning</strong><p>{detail.operationNote}</p></div></div></section>}

    {detail.template === 'custom-project' && <section class="detail-section detail-template-section product-custom-planning"><div class="container"><div class="detail-template-heading"><p class="eyebrow">{templateLabels.eyebrow}</p><h2>{templateLabels.heading}</h2><p>{templateLabels.text}</p></div><div class="detail-custom-grid"><div class="detail-custom-copy"><h3>Customization options</h3><ul>{detail.customization.map((item) => <li>{item}</li>)}</ul></div><div class="detail-custom-copy detail-custom-dark"><h3>Project information for a quote</h3><ul>{detail.quoteItems.map((item) => <li>{item}</li>)}</ul></div></div><div class="detail-project-flow"><span>Project brief</span><span>Artwork review</span><span>Specification confirmation</span><span>Production</span><span>Inspection &amp; packing</span></div></div></section>}

    <section class="detail-section product-sourcing-section"><div class="container"><div class="detail-template-heading"><p class="eyebrow">Commercial sourcing brief</p><h2>Plan {primaryKeyword} for your buying program</h2><p>Use this product-level brief to connect the visible design with your buyer profile, operating use, customization scope, and factory quotation requirements.</p></div><div class="product-sourcing-grid"><article class="product-sourcing-card"><p class="sourcing-label">Best-fit buyers</p><h3>Who this model is built for</h3><div class="detail-buyer-tags">{targetBuyers.map((buyer) => <span>{buyer}</span>)}</div><p class="sourcing-card-copy">{detail.purpose}</p><ul class="sourcing-list buyer-fit-list"><li><strong>Commercial role</strong><span>{detail.applications[0]?.title ?? product.category}</span></li><li><strong>Buyer planning focus</strong><span>{detail.customization[0]}</span></li></ul></article><article class="product-sourcing-card"><p class="sourcing-label">Commercial use</p><h3>Where it creates value</h3><ul class="sourcing-list">{detail.applications.map((application) => <li><strong>{application.title}</strong><span>{application.text}</span></li>)}</ul></article><article class="product-sourcing-card"><p class="sourcing-label">OEM / ODM scope</p><h3>What can be customized</h3><ul class="sourcing-list">{detail.customization.map((item) => <li><span>{item}</span></li>)}</ul></article><article class="product-sourcing-card"><p class="sourcing-label">Quotation checklist</p><h3>What to send before pricing</h3><ul class="sourcing-list">{detail.quoteItems.map((item) => <li><span>{item}</span></li>)}</ul></article></div><div class="product-order-confirmation"><strong>Order confirmation</strong><p>For this {primaryKeyword} listing, the catalog shows a 3-year warranty, 7-10 Work Days lead time, and EN14960 / ASTM / CE / NFPA 701 compliance information. Confirm the final configuration, accessory scope, artwork, packing, applicable documents, and destination-market requirements with YIC before production.</p></div><div class="product-sourcing-footer"><div>{relatedBuyerSearches.length > 0 && <><strong>Related buyer searches</strong><span class="product-search-terms">{relatedBuyerSearches.map((term) => <span>{term}</span>)}</span></>}</div><div class="product-sourcing-links"><a class="text-link" href={categoryPath(product.categorySlug)}>Browse all {product.category} models →</a><a class="text-link" href={buyerGuide.href}>{buyerGuide.label} →</a><a class="text-link" href={procurementGuide.href}>{procurementGuide.label} →</a></div></div></div></section>

    <section class="detail-section section-muted product-proof-section"><div class="container"><div class="detail-template-heading"><p class="eyebrow">Factory proof</p><h2>Why source this product from YIC?</h2><p>YIC connects product-specific design support with repeatable production, inspection, export packing, and communication for international buyers.</p></div><div class="detail-proof-grid"><article><strong>15+ years</strong><span>Manufacturing and export experience</span></article><article><strong>Artwork approval</strong><span>Review the visual and structural brief before production</span></article><article><strong>Multi-stage QC</strong><span>Material, construction, inflation or operation checks</span></article><article><strong>OEM / ODM</strong><span>Custom colors, dimensions, layouts, and branding</span></article><article><strong>Global delivery</strong><span>Packing and destination coordination for repeat orders</span></article></div></div></section>

    <section class="detail-section section-muted"><div class="container"><div class="detail-template-heading"><p class="eyebrow">Buyer questions</p><h2>{displayTitle} FAQ</h2><p>Six product-specific questions covering specifications, applications, customization, quality, delivery, and commercial planning.</p></div><div class="faq-list product-faq-list">{faqs.map((faq) => <details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div></section>
    {relatedProducts.length > 0 && <section class="section related-products"><div class="container"><div class="section-heading"><div><p class="eyebrow">More from this category</p><h2>Compare related {product.category} models</h2></div><a class="text-link" href={categoryPath(product.categorySlug)}>View all {product.category} →</a></div><div class="product-grid">{relatedProducts.map((item) => <ProductCard product={item} />)}</div></div></section>}
    <section class="cta-band"><div class="container cta-band-inner"><div><p class="eyebrow">Factory quotation</p><h2>Need {displayTitle} for your market?</h2><p>Send YIC your quantity, destination, product requirements, and branding brief for a practical factory quotation.</p></div><a class="button button-secondary" href={`/contact/?product=${encodeURIComponent(displayTitle)}&source=${encodeURIComponent(pageUrl)}`}>Talk to the factory</a></div></section>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script>
    const gallery = document.querySelector('[data-gallery]');
    const mainImage = gallery?.querySelector('[data-main-image]');
    gallery?.querySelectorAll('button[data-image]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!mainImage) return;
        mainImage.src = button.dataset.image ?? mainImage.src;
        gallery.querySelectorAll('button[data-image]').forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
      });
    });
  </script>
</SiteLayout>
