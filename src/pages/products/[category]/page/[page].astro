---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import Pagination from '../../../../components/Pagination.astro';
import { categories, products, categoryPath, publicCategorySlug, categorySeoProfile, company, productAbsoluteUrl, productDisplayTitle, seoTitle } from '../../../../data/site';

const pageSize = 16;

export function getStaticPaths() {
  return categories.flatMap((category) => {
    const totalPages = Math.ceil(products.filter((product) => product.categorySlug === category.slug).length / 16);
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({ params: { category: publicCategorySlug(category.slug), page: String(index + 2) }, props: { category, page: index + 2 } }));
  });
}

const { category, page } = Astro.props as { category: (typeof categories)[number]; page: number };
const profile = categorySeoProfile(category.name);
const categoryProducts = products.filter((product) => product.categorySlug === category.slug);
const totalPages = Math.ceil(categoryProducts.length / pageSize);
const pageProducts = categoryProducts.slice((page - 1) * pageSize, page * pageSize);
const pageUrl = `https://${company.domain}${categoryPath(category)}page/${page}/`;
const collectionSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${pageUrl}#collection`, name: `${profile.h1} | Page ${page}`, url: pageUrl,
  description: profile.description, isPartOf: { '@id': `https://${company.domain}${categoryPath(category)}#collection` },
  mainEntity: { '@type': 'ItemList', numberOfItems: pageProducts.length, itemListElement: pageProducts.map((product, index) => ({ '@type': 'ListItem', position: ((page - 1) * pageSize) + index + 1, url: productAbsoluteUrl(product), name: productDisplayTitle(product) })) },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${company.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `https://${company.domain}/products/` },
    { '@type': 'ListItem', position: 3, name: category.name, item: `https://${company.domain}${categoryPath(category)}` },
    { '@type': 'ListItem', position: 4, name: `Page ${page}`, item: pageUrl },
  ],
};
---

<SiteLayout title={seoTitle(`${profile.title.replace(/\s*\|\s*YIC.*$/i, '')} | More Models`)} description={`Browse additional ${category.name.toLowerCase()} models from YIC. Open any model for specifications and a factory quotation.`} image={category.heroImage} imageAlt={`Commercial ${category.name.toLowerCase()} products manufactured by YIC`} keywords={`${category.name.toLowerCase()}, commercial ${category.name.toLowerCase()}, OEM inflatables`} robots="noindex, follow">
  <section class="page-hero category-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/products/">Products</a> / <a href={categoryPath(category)}>{category.name}</a> / Page {page}</div><p class="eyebrow">{category.name} catalog · Page {page}</p><h1>More {category.name} Models</h1><p>Use this catalog page to compare additional models. For the full category buying guide, OEM overview, and category FAQs, visit the main {category.name} page.</p><div class="hero-actions"><a class="button button-secondary" href={categoryPath(category)}>View category overview</a><a class="button button-secondary" href="#catalog">Browse models</a></div></div></section>

  <section class="section section-muted" id="catalog"><div class="container"><div class="category-intro"><div><p class="eyebrow">Factory catalog · {category.name} · Page {page}</p><h2>More {category.name} models for your next order</h2></div><p>Open any model for specifications, applications, product-level FAQs, and a direct quotation request. The catalog uses 16 products per page for easier comparison.</p></div><div class="product-grid">{pageProducts.map((product) => <ProductCard product={product} />)}</div><Pagination currentPage={page} totalPages={totalPages} basePath={categoryPath(category)} label={`${category.name} product pages`} /></div></section>

  <section class="cta-band"><div class="container cta-band-inner"><div><p class="eyebrow">Factory quotation</p><h2>Need help comparing these models?</h2><p>Send YIC the models, quantity, destination, artwork, dimensions, or custom requirements you want quoted.</p></div><a class="button button-secondary" href="/contact/">Request a factory quote</a></div></section>

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
</SiteLayout>
