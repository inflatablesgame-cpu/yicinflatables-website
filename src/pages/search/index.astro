---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/site';
import { blogArticles } from '../../data/blog';

const searchItems = products.map((product) => ({
  product,
  searchText: `${product.title} ${product.category} ${product.material}`.toLowerCase(),
}));
---

<SiteLayout
  title="Search Commercial Inflatables | YIC Inflatable Sports"
  description="Search YIC's commercial inflatable catalog and B2B buying guides by product name, category, application, or industry topic."
  keywords="search commercial inflatables, bounce house supplier, inflatable products catalog, inflatable buying guides"
  robots="noindex, follow"
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Home</a> / Search</div>
      <p class="eyebrow">Product search</p>
      <h1>Find the right commercial inflatable</h1>
      <p>Search by product name, category, material, or topic to find matching products and inflatable industry guides.</p>
    </div>
  </section>

  <section class="section search-page">
    <div class="container">
      <form class="catalog-search" id="catalog-search" role="search">
        <label for="product-search">Search products and Blog resources</label>
        <div class="catalog-search-row">
          <input id="product-search" name="q" type="search" placeholder="Try: bounce house, water slide, obstacle course…" autocomplete="off" />
          <button class="button" type="submit">Search</button>
        </div>
        <p class="search-summary" id="search-summary" aria-live="polite">Showing all {products.length} products and {blogArticles.length} articles.</p>
      </form>
      <div class="search-result-grid" id="search-results">
        {searchItems.map(({ product, searchText }) => <div class="search-result-item" data-result-type="product" data-search-text={searchText}><ProductCard product={product} /></div>)}
        {blogArticles.map((article) => <article class="search-result-item search-article-card article-card" data-result-type="article" data-search-text={`${article.title} ${article.description} ${article.category} ${article.keywords}`.toLowerCase()}><div class="article-card-top"><span>Blog · {article.category}</span><span>{article.readTime}</span></div><h3><a href={`/blog/${article.slug}/`}>{article.title}</a></h3><p>{article.description}</p><a class="text-link" href={`/blog/${article.slug}/`}>Read the guide →</a></article>)}
      </div>
      <p class="search-empty" id="search-empty" hidden>No products or articles matched that search. Try a broader keyword or <a href="/contact/">send us your request</a>.</p>
    </div>
  </section>
</SiteLayout>

<script>
  const form = document.querySelector('#catalog-search');
  const input = document.querySelector('#product-search');
  const summary = document.querySelector('#search-summary');
  const empty = document.querySelector('#search-empty');
  const cards = [...document.querySelectorAll('.search-result-item')];
  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q')?.trim() ?? '';

  const renderResults = (rawQuery) => {
    const query = rawQuery.trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || card.dataset.searchText?.includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    const productsFound = cards.filter((card) => !card.hidden && card.dataset.resultType === 'product').length;
    const articlesFound = cards.filter((card) => !card.hidden && card.dataset.resultType === 'article').length;
    if (summary) summary.textContent = query ? `${productsFound} product${productsFound === 1 ? '' : 's'} and ${articlesFound} article${articlesFound === 1 ? '' : 's'} found for “${rawQuery.trim()}”.` : `Showing all ${products.length} products and ${blogArticles.length} articles.`;
    if (empty) empty.hidden = visible !== 0;
  };

  if (input) {
    input.value = initialQuery;
    renderResults(initialQuery);
    input.addEventListener('input', () => renderResults(input.value));
  }
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = input?.value.trim() ?? '';
    const nextUrl = query ? `/search/?q=${encodeURIComponent(query)}` : '/search/';
    window.history.replaceState({}, '', nextUrl);
    renderResults(query);
  });
</script>
