---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { company } from '../../data/site';

const origin = `https://${company.domain}`;
const processEvidence = [
  { image: '/assets/optimized/about/raw-material.webp', full: '/assets/about%E9%A1%B5/commercial-inflatable-manufacturer-yic-raw-material-inspection.webp', title: 'Raw material review', text: 'Visible material and accessory inspection before cutting for the approved production specification.' },
  { image: '/assets/optimized/about/auto-cutting.webp', full: '/assets/about%E9%A1%B5/commercial-inflatable-manufacturing-auto-cutting.webp', title: 'Pattern cutting', text: 'Digital cutting follows the confirmed layout and production pattern for the order.' },
  { image: '/assets/optimized/about/in-process.webp', full: '/assets/about%E9%A1%B5/commercial-inflatable-manufacturer-yic-in-process-inspection.webp', title: 'In-process inspection', text: 'Construction and assembly are reviewed while the product is in production.' },
  { image: '/assets/optimized/about/inflation-test.webp', full: '/assets/about%E9%A1%B5/commercial-inflatable-manufacturing-capability.webp', title: 'Inflation review', text: 'Finished units are inflated to review visible form, connections and operational presentation.' },
  { image: '/assets/optimized/about/detailed-inspection.webp', full: '/assets/commercial-inflatable-manufacturer-detailed-inspection.webp', title: 'Detailed inspection', text: 'Finished details are reviewed before the order moves to final packing.' },
  { image: '/assets/optimized/about/packing-inspection.webp', full: '/assets/about%E9%A1%B5/commercial-inflatable-manufacturer-yic-factory-packing-inspection.webp', title: 'Export packing review', text: 'Products, accessories and packing scope are checked before export dispatch.' },
];
const documents = [
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-EN14960-certificate.webp', name: 'EN 14960 document', market: 'Europe', scope: 'Reviewed against the final land-based inflatable model, intended use and destination requirements; not presented as an automatic approval for every catalog product.' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-ISO25649-certificate.webp', name: 'ISO 25649 document', market: 'Water / leisure projects', scope: 'Reviewed only where the final water or leisure product, site and operator requirements make this document relevant.' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-ROHS-reach-compliance.webp', name: 'RoHS / REACH report', market: 'Material / component review', scope: 'Supporting material or component documentation. The buyer should confirm the exact item, revision and destination requirement covered.' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-UL-certified.webp', name: 'UL document', market: 'United States / component review', scope: 'Reviewed for the applicable listed component or equipment scope; it is not shown as a blanket certification for a complete custom inflatable.' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-CB-certified.webp', name: 'CB certificate', market: 'Electrical component review', scope: 'Reviewed for the specified electrical component and order configuration where applicable.' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-flame-retardant-report.webp', name: 'Flame-retardant report', market: 'Venue / material review', scope: 'Reviewed only for the specified fabric or film components when the project, venue or destination requires it.' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-huawei-air-blower-ce.webp', name: 'Air blower CE document', market: 'Europe / blower component', scope: 'Component documentation for the supplied blower configuration, not a universal certificate for every inflatable structure.' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-air-pump-ce-certificate.webp', name: 'Air pump CE document', market: 'Europe / pump component', scope: 'Component documentation for the supplied pump configuration, when that component is included in the approved order.' },
];
const faqs = [
  { question: 'Does a document shown here certify every YIC product?', answer: 'No. Each certificate, report or component file has its own scope. The final product model, dimensions, materials, supplied components, destination and intended use must be checked against that scope before production.' },
  { question: 'How are European and United States requirements handled?', answer: 'For land-based commercial inflatables, YIC reviews the approved configuration against the buyer’s requested EN 14960-1, ASTM F2374 and local venue requirements where applicable. Waterborne products and event structures require their own product- and site-specific review.' },
  { question: 'What evidence can be confirmed for a final order?', answer: 'The quotation and approved order file should identify the model reference, materials, dimensions, artwork, accessories, packing scope, applicable documents and destination-market requirements. Production and inspection records relate to that approved order rather than a catalog image.' },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${origin}/factory-evidence/#evidence`,
  name: 'YIC Factory, Quality and Documentation Evidence',
  url: `${origin}/factory-evidence/`,
  description: 'Public factory-process images and documentation-scope guidance for commercial inflatable B2B buyers.',
  isPartOf: { '@id': `${origin}/#website` },
  about: { '@id': `${origin}/#organization` },
  mainEntity: { '@type': 'ItemList', itemListElement: [...processEvidence.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.title })), ...documents.map((item, index) => ({ '@type': 'ListItem', position: processEvidence.length + index + 1, name: item.name }))] },
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) };
---

<SiteLayout title="Factory Quality and Documentation Evidence | YIC" description="Review YIC factory-process evidence and documentation scope for commercial inflatable B2B orders, including market-specific certificate and component-file guidance." image={processEvidence[0].image} imageAlt="YIC commercial inflatable raw material inspection" keywords="commercial inflatable factory evidence, inflatable quality control, EN 14960 documentation, ASTM F2374, CE blower document, inflatable manufacturer inspection">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Factory evidence</div><p class="eyebrow">Traceable B2B evidence · scope-first documentation</p><h1>Factory, Quality and Documentation Evidence</h1><p>This public evidence library connects YIC’s visible manufacturing process with documentation that may be reviewed for a final commercial inflatable order. It is designed for B2B buyers, procurement teams and venue operators who need clear scope—not generic certificate claims.</p><div class="hero-actions"><a class="button" href="/contact/">Request model-specific documents</a><a class="button button-secondary" href="/case-studies/">View project references</a></div></div></section>
  <section class="section"><div class="container evidence-intro-grid"><div><p class="eyebrow">How to read this page</p><h2>Visible factory process + final-order confirmation</h2><p>The photos below show the type of process evidence available from YIC’s commercial inflatable manufacturing flow. The final quotation and approved order file remain the source of truth for the exact model, dimensions, materials, artwork, components, packing and destination-market documentation.</p></div><div class="evidence-scope-note"><strong>Important scope rule</strong><p>Images, reports and component certificates are supporting evidence. They do not create a universal claim that every catalog product is certified for every market or operating environment.</p></div></div></section>
  <section class="section section-muted"><div class="container"><div class="section-heading"><div><p class="eyebrow">Process evidence</p><h2>Commercial production checkpoints</h2></div><p>Open each image for the full factory reference. These checkpoints support product-specific order discussions, quality expectations and inspection planning.</p></div><div class="evidence-process-grid">{processEvidence.map((item, index) => <article><a href={item.full} target="_blank" rel="noopener"><img src={item.image} alt={`${item.title} at YIC commercial inflatable factory`} loading="lazy" width="520" height="390" /></a><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Document library</p><h2>Certificate Library and Document Scope</h2></div><p>Open the visible supporting document, then ask YIC to confirm whether it applies to the final model, material, components and destination. The labels below intentionally state the limits of each evidence type.</p></div><div class="evidence-document-grid">{documents.map((document) => <article><a href={document.image} target="_blank" rel="noopener"><img src={document.image} alt={`${document.name} available for YIC commercial inflatable compliance documentation`} loading="lazy" width="600" height="800" /></a><p class="eyebrow">{document.market}</p><h3>{document.name}</h3><p>{document.scope}</p><a class="text-link" href={document.image} target="_blank" rel="noopener">Open document ↗</a></article>)}</div></div></section>
  <section class="section section-muted"><div class="container"><div class="section-heading"><div><p class="eyebrow">Buyer FAQ</p><h2>Evidence and compliance questions</h2></div><p>Use these questions when comparing a catalog model with your market, venue and order requirements.</p></div><div class="faq-list">{faqs.map((faq) => <details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div></section>
  <section class="cta-band"><div class="container cta-band-inner"><div><p class="eyebrow">Model-specific review</p><h2>Need evidence for a particular product and destination?</h2><p>Send the product URL, quantity, destination, intended use and required documents. YIC will confirm the relevant order scope before production.</p></div><a class="button button-secondary" href="/contact/">Request documentation review</a></div></section>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</SiteLayout>
