---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { company } from '../../data/site';

const image = (name) => `/assets/about%E9%A1%B5/${encodeURIComponent(name)}`;
const optimizedImage = (name) => `/assets/optimized/about/${name}`;
const materialImage = optimizedImage('materials.webp');
const feedbackImage = '/assets/YIC_customer_feedback_2column_original_layout.webp';
const feedbackDisplayImage = optimizedImage('customer-feedback.webp');
const exhibitionImage = '/assets/commercial-inflatable-manufacturer-clients-exhibition-2026.webp';
const exhibitionDisplayImage = optimizedImage('exhibition.webp');
const productionProcessImage = '/assets/production-process-overview.webp';
const processSteps = [
  { image: '/assets/%E7%94%9F%E6%88%90%E6%B5%81%E7%A8%8B%E5%9B%BE/commercial-inflatable-manufacturer-yic-design-process.webp', title: 'Design confirmation', text: 'We review your idea, dimensions, artwork, and intended use before production.' },
  { image: '/assets/%E7%94%9F%E6%88%90%E6%B5%81%E7%A8%8B%E5%9B%BE/commercial-inflatable-manufacturer-yic-material-cutting.webp', title: 'Material cutting', text: 'Approved materials are checked and cut against the confirmed production layout.' },
  { image: '/assets/%E7%94%9F%E6%88%90%E6%B5%81%E7%A8%8B%E5%9B%BE/commercial-inflatable-manufacturer-yic-sewing-production.webp', title: 'Sewing and reinforcement', text: 'Seams and high-stress points are constructed for repeated commercial use.' },
  { image: '/assets/%E7%94%9F%E6%88%90%E6%B5%81%E7%8A%B6%E5%9B%BE/commercial-inflatable-manufacturer-yic-heat-sealing-splicing.webp', title: 'Heat sealing', text: 'Selected product structures receive controlled heat-sealed splicing.' },
  { image: '/assets/%E7%94%9F%E6%88%90%E6%B5%81%E5%9B%BE/commercial-inflatable-manufacturer-yic-inflation-testing.webp', title: 'Inflation testing', text: 'Finished units are inflated to review appearance, seams, and operation.' },
  { image: '/assets/%E7%94%9F%E6%88%90%E6%B5%81%E5%9B%BE/commercial-inflatable-manufacturer-yic-inspection-packaging.webp', title: 'Final inspection', text: 'Inspection points are completed before the product is prepared for packing.' },
  { image: '/assets/%E7%94%9F%E6%88%90%E6%B5%81%E5%9B%BE/commercial-inflatable-manufacturer-yic-packing-shipping.webp', title: 'Export packing', text: 'Packing and shipment details are prepared for the destination market.' },
];
const factoryImages = [
  { src: '/assets/commercial-inflatable-manufacturer-workshop-interior.webp', alt: 'Interior of the YIC commercial inflatable manufacturing workshop' },
  { src: image('commercial-inflatable-manufacturer-yic-raw-material-inspection.webp'), alt: 'Commercial PVC material inspection at YIC factory' },
  { src: image('commercial-inflatable-manufacturer-yic-in-process-inspection.webp'), alt: 'In-process quality inspection at YIC factory' },
  { src: image('commercial-inflatable-manufacturer-yic-factory-packing-inspection.webp'), alt: 'Finished inflatable packing inspection at YIC factory' },
];
const qualityControlImages = [
  { src: optimizedImage('raw-material.webp'), full: image('commercial-inflatable-manufacturer-yic-raw-material-inspection.webp'), alt: 'Raw commercial PVC material inspection at YIC factory', title: 'Raw Material', text: 'PVC and accessory materials are checked before production.' },
  { src: optimizedImage('auto-cutting.webp'), full: image('commercial-inflatable-manufacturing-auto-cutting.webp'), alt: 'Automated inflatable material cutting at YIC factory', title: 'Auto Cutting', text: 'Digital cutting follows the confirmed production pattern.' },
  { src: optimizedImage('in-process.webp'), full: image('commercial-inflatable-manufacturer-yic-in-process-inspection.webp'), alt: 'In-process inflatable production inspection at YIC factory', title: 'In-Process', text: 'Sewing and assembly are checked during production.' },
  { src: optimizedImage('inflation-test.webp'), full: image('commercial-inflatable-manufacturing-capability.webp'), alt: 'Inflatable products prepared for inflation testing at YIC factory', title: 'Inflation Test', text: 'Units are inflated to check shape and air retention.' },
  { src: optimizedImage('detailed-inspection.webp'), full: '/assets/commercial-inflatable-manufacturer-detailed-inspection.webp', alt: 'Detailed finished inflatable inspection at YIC factory', title: 'Detailed Inspection', text: 'Finished details are reviewed before final approval.' },
  { src: optimizedImage('packing-inspection.webp'), full: image('commercial-inflatable-manufacturer-yic-factory-packing-inspection.webp'), alt: 'Inflatable packing inspection at YIC factory', title: 'Packing Inspection', text: 'Products and accessories are checked before export packing.' },
];
const certificates = [
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-UL-certified.webp', name: 'UL document' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-ROHS-reach-compliance.webp', name: 'RoHS / REACH report' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-ISO25649-certificate.webp', name: 'ISO 25649 document' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-EN14960-certificate.webp', name: 'EN 14960 document' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-CB-certified.webp', name: 'CB certificate' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-flame-retardant-report.webp', name: 'Flame-retardant report' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-huawei-air-blower-ce.webp', name: 'Air blower CE certificate · TÜV' },
  { image: '/assets/%E8%AF%81%E4%B9%A6/commercial-inflatable-manufacturer-air-pump-ce-certificate.webp', name: 'Air pump CE certificate · TCT' },
];
---

<SiteLayout title="Guangzhou Inflatable Factory | Custom OEM Manufacturer | YIC" description="YIC is a Guangzhou inflatable factory and custom inflatable manufacturer in China, providing OEM/ODM production for B2B party rental and entertainment buyers." image={factoryImages[0].src} imageAlt={factoryImages[0].alt} keywords="Guangzhou inflatable factory, custom inflatable manufacturer in China, OEM ODM inflatable production, B2B inflatable party rental supplier, commercial inflatable factory">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / About Us</div><p class="eyebrow">Guangzhou, China · OEM / ODM inflatable production</p><h1>Guangzhou Inflatable Manufacturer &amp; OEM Factory</h1><p>YIC Inflatable Sports is a custom inflatable manufacturer in China, serving party rental companies, entertainment venues, event operators, and distributors with factory-direct commercial inflatable production.</p></div></section>
  <section class="section"><div class="container about-grid"><div class="about-copy"><p class="eyebrow">Who we are</p><h2>A Factory Built for Commercial Inflatable Production and OEM Projects</h2><p>{company.name} has more than 15 years of experience manufacturing and exporting commercial inflatable products from Guangzhou, China. Our team includes 116 long-term professionals, supported by automatic cutting, heavy-duty sewing, and heat-sealing equipment.</p><p>As a B2B inflatable party rental supplier, we work with more than 3,100 rental companies, entertainment businesses, event operators, and distributors across 57 countries, including the United States, the United Kingdom, and European markets.</p><p>Our OEM/ODM inflatable production service turns your reference image, dimensions, artwork, product brief, and market requirements into a practical factory specification for production, inspection, packing, and export.</p></div><figure class="about-factory-collage"><img src={optimizedImage('factory-collage.webp')} alt="YIC Guangzhou inflatable factory exterior, PVC material preparation, production workshop, automated cutting, and finished inflatable products" loading="lazy" width="800" height="948" /></figure></div></section>
  <section class="section section-muted"><div class="container feature-grid about-quality-grid"><div class="feature-copy"><p class="eyebrow">What we offer</p><h2>Quality control you can explain to your customers</h2><p>Commercial orders need more than a good-looking sample. We keep the production flow visible so your team can make decisions with confidence.</p><ul class="check-list"><li>Plato PVC raw material for applicable products</li><li>Product-specific material selection and inspection before cutting</li><li>In-process quality checks</li><li>Inflation and appearance testing</li><li>OEM and ODM support</li><li>Export packing coordination</li></ul></div><div class="about-quality-gallery">{qualityControlImages.map((qualityImage, index) => <article class="about-quality-card"><a href={qualityImage.full} target="_blank" rel="noopener" aria-label={`Open ${qualityImage.alt} in a new tab`}><img src={qualityImage.src} alt={qualityImage.alt} loading="lazy" width="320" height="240" /></a><strong>0{index + 1}</strong><h3>{qualityImage.title}</h3><p>{qualityImage.text}</p></article>)}</div></div></section>
  <section class="section about-material-section"><div class="container feature-grid about-material-grid"><div class="feature-image about-material-image"><img src={materialImage} alt="Commercial PVC inflatable material layers and performance specifications" loading="lazy" width="1200" height="1298" /></div><div class="feature-copy"><p class="eyebrow">Commercial-grade materials</p><h2>Materials selected for real rental use</h2><p>For applicable PVC products, we source raw material from Plato. Material grade and thickness are selected to suit each product's structure and intended use, then confirmed before production.</p><ul class="check-list"><li>Plato PVC raw material for applicable products</li><li>Reinforced PVC tarpaulin layers</li><li>Waterproof and abrasion-resistant surfaces</li><li>Polyester mesh for tensile strength where specified</li><li>Material options for sewing and heat sealing</li><li>Specification review before production</li></ul><a class="text-link" href="/contact/">Ask about material options →</a></div></div></section>
  <section class="section section-muted about-process-section"><div class="container feature-grid about-process-layout"><div class="feature-copy"><p class="eyebrow">Production process</p><h2>From drawing to ready-to-ship production</h2><div class="process-copy"><p><strong>Drawing &amp; 3D Design:</strong> Translating your custom ideas into precise structural layouts and vivid 3D renderings.</p><p><strong>Pattern &amp; Printing:</strong> Professional pattern making coupled with high-definition, eco-friendly printing for vibrant, long-lasting visuals.</p><p><strong>Cutting &amp; Heavy-Duty Sewing:</strong> Automated precision cutting followed by expert double/quadruple stitching using commercial-grade 0.55mm PVC.</p><p><strong>QC, Packing &amp; Shipping:</strong> Rigorous inflation testing, meticulous final inspection, and secure export packing ready for worldwide logistics.</p></div><a class="text-link" href="/contact/">Discuss a custom production project →</a></div><figure class="about-process-figure"><a href={productionProcessImage} target="_blank" rel="noopener" aria-label="Open the complete production process image in a new tab"><img class="about-process-overview" src={productionProcessImage} alt="YIC inflatable production process from drawing and 3D design to quality inspection and shipment" loading="lazy" width="750" height="775" /></a></figure></div></section>
  <section class="section about-feedback-section"><div class="container feature-grid about-feedback-grid"><div class="feature-copy"><p class="eyebrow">Customer feedback</p><h2>Real Feedback from Global Partners</h2><div class="feedback-copy"><p><strong>Repeat Orders:</strong> Many of our international clients return for second and third orders, trusting our commercial-grade quality.</p><p><strong>Smooth Communication:</strong> From custom design discussions to final shipping, our WhatsApp and online support keep everything transparent.</p><p><strong>Quality Verified:</strong> Real 5-star reviews and unedited chat logs from business owners worldwide who trust our 0.55mm PVC inflatables.</p></div><a class="text-link" href="/contact/">Start your next project →</a></div><figure class="about-feedback-figure"><a href={feedbackImage} target="_blank" rel="noopener" aria-label="Open customer feedback image in a new tab"><img class="about-feedback-image" src={feedbackDisplayImage} alt="Customer feedback and buyer conversations for YIC Inflatable Sports" loading="lazy" width="700" height="1480" /></a></figure></div></section>
  <section class="section section-muted about-exhibition-section"><div class="container feature-grid about-exhibition-grid"><figure class="about-exhibition-figure"><a href={exhibitionImage} target="_blank" rel="noopener" aria-label="Open exhibitions and factory visits image in a new tab"><img class="about-exhibition-image" src={exhibitionDisplayImage} alt="YIC Inflatable Sports commercial inflatables displayed at international exhibitions with global buyers and factory partners" loading="lazy" width="1000" height="535" /></a><figcaption>Customer visits, product demonstrations, and global exhibition conversations.</figcaption></figure><div class="feature-copy"><p class="eyebrow">Exhibitions &amp; factory visits</p><h2>Trusted by Global Partners Worldwide</h2><p>We regularly showcase our latest commercial bounce houses, water slides, and custom inflatables at major international trade shows. Connect with our expert team on-site, check product quality firsthand, and discover how we bring your custom designs to life.</p><a class="text-link" href="/contact/">Discuss your project with YIC →</a></div></div></section>
  <section class="section"><div class="container"><div class="section-heading certificate-heading"><div><p class="eyebrow">Certifications &amp; compliance</p><h2>Compliance documents available by product and market</h2></div><p>Documentation must be checked against the exact product, component, and destination market. Ask YIC to confirm the applicable certificates, test reports, and supporting files for your requested model before ordering.</p></div><div class="certificate-grid">{certificates.map((certificate) => <figure><a class="certificate-link" href={certificate.image} target="_blank" rel="noopener" aria-label={`Open ${certificate.name} document in a new tab`}><img src={certificate.image} alt={`${certificate.name} from YIC Inflatable Sports`} loading="lazy" width="600" height="800" /></a><figcaption><strong>{certificate.name}</strong><span>Open full document ↗</span></figcaption></figure>)}</div></div></section>
  <section class="cta-band"><div class="container cta-band-inner"><h2>Looking for a factory that can support repeat orders?</h2><a class="button button-secondary" href="/contact/">Start a conversation</a></div></section>
</SiteLayout>
