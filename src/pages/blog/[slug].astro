---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { blogArticles, getBlogArticle } from '../../data/blog';
import { getBuyerGuideProfile } from '../../data/buyer-guides';
import { categories, categoryPath, company, products, productDetailImage, productImageAlt, productPath, seoTitle } from '../../data/site';

export function getStaticPaths() {
  return blogArticles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article: routeArticle } = Astro.props;
const article = routeArticle ?? getBlogArticle(Astro.params.slug ?? '');
if (!article) throw new Error('Blog article not found');

const imageProduct = article.imageProductSlug
  ? products.find((product) => product.productSlug === article.imageProductSlug)
  : undefined;
const image = article.image?.src ?? (imageProduct ? productDetailImage(imageProduct) : '/assets/commercial-inflatable-manufacturer-workshop-interior.webp');
const imageAlt = article.image?.alt ?? (imageProduct ? productImageAlt(imageProduct) : `Commercial inflatable production workshop`);
const imageCaption = article.image?.caption;
const displayTitle = article.shortTitle ?? article.title;
const isSpanish = article.language === 'es';
const labels = isSpanish ? {
  home: 'Inicio', blog: 'Blog', published: 'Publicado', updated: 'Actualizado',
  resource: 'Recurso de compra de YIC Inflatable Sports', quickAnswer: 'Respuesta rápida',
  contents: 'En esta guía', decisionEyebrow: 'Decisión antes de cotizar',
  decisionTitle: 'Qué significa esta guía para un comprador comercial',
  checklistEyebrow: 'Lista de verificación', checklistTitle: 'Datos que debe confirmar antes de comparar proveedores',
  risksEyebrow: 'Control de riesgos', risksTitle: 'Errores comunes que conviene evitar',
  questionsEyebrow: 'Consulta a fábrica', questionsTitle: 'Preguntas que debe enviar antes de aprobar el pedido',
  faqEyebrow: 'Preguntas frecuentes', exploreTitle: 'Explore productos inflables comerciales relacionados',
  exploreBody: 'Compare las categorías relacionadas con esta guía y envíe a YIC los modelos, la cantidad, el destino y los detalles de personalización para solicitar una cotización.',
  specsTitle: 'Especificaciones de productos relacionados',
  specsBody: 'Estos modelos del catálogo ofrecen un punto de partida concreto. Confirme las medidas, los componentes, el material y el alcance del pedido en la cotización.',
  viewDetails: 'Ver detalles del producto →', resourcesTitle: 'Recursos de compra relacionados',
  contactTitle: 'Hable con un fabricante de inflables comerciales',
  contactBody: '¿Tiene una lista de productos, una idea personalizada o un plan para su establecimiento?',
  sendRequirements: 'Envíe sus requisitos a YIC',
  contactTail: 'e incluya el mercado de destino, la cantidad, las medidas, el diseño gráfico y la fecha de entrega deseada. También puede',
  browseCatalog: 'consultar el catálogo de productos comerciales', continue: 'Seguir aprendiendo',
  relatedTitle: 'Guías de compra relacionadas', readGuide: 'Leer la guía →',
  rentalNote: 'Nota de compra comercial: esta guía está dirigida a operadores y distribuidores que compran equipos para una flota o un establecimiento. YIC es un fabricante directo de fábrica, no un servicio local de alquiler para consumidores.',
  categoryNames: {
    'Product Guide': 'Guía de productos',
    'Inflatable Water Slide': 'Toboganes inflables comerciales',
    'Inflatable Water Park': 'Parques acuáticos inflables',
    'Inflatable Games': 'Juegos inflables',
    'Inflatable Theme Park': 'Parque de atracciones inflable',
    'Inflatable Slide': 'Toboganes inflables',
  } as Record<string, string>,
} : {
  home: 'Home', blog: 'Blog', published: 'Published', updated: 'Updated',
  resource: 'YIC Inflatable Sports buyer resource', quickAnswer: 'Quick answer',
  contents: 'In this guide', decisionEyebrow: 'Decision before quotation',
  decisionTitle: 'What this guide means for a commercial buyer',
  checklistEyebrow: 'Buyer checklist', checklistTitle: 'Information to confirm before comparing suppliers',
  risksEyebrow: 'Risk control', risksTitle: 'Common mistakes to avoid',
  questionsEyebrow: 'Factory conversation', questionsTitle: 'Questions to send before the order is released',
  faqEyebrow: 'Buyer FAQ', exploreTitle: 'Explore relevant commercial inflatables',
  exploreBody: 'Compare the product categories that relate to this buying guide, then send YIC the models, quantity, destination, and customization details you want quoted.',
  specsTitle: 'Related product specifications',
  specsBody: 'These catalog models give buyers a concrete starting point. Confirm the final size, components, material, and order scope against the quotation.',
  viewDetails: 'View product details →', resourcesTitle: 'Related buyer resources',
  contactTitle: 'Talk with a commercial inflatable manufacturer',
  contactBody: 'Have a product list, custom idea, or venue plan?',
  sendRequirements: 'Send your requirements to YIC',
  contactTail: 'and include the destination market, quantity, dimensions, artwork, and target delivery date. You can also',
  browseCatalog: 'browse the commercial product catalog', continue: 'Continue learning',
  relatedTitle: 'Related buyer guides', readGuide: 'Read guide →',
  rentalNote: 'Commercial procurement note: This guide is for operators and distributors buying equipment for a fleet or venue. YIC is a factory-direct manufacturer, not a local consumer rental service.',
  categoryNames: {} as Record<string, string>,
};
const articleUrl = `https://${company.domain}/blog/${article.slug}/`;
const sectionId = (heading: string) => heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const categoryLinksByTopic: Record<string, string[]> = {
  'Rental Business': ['bounce-house', 'bounce-house-combo', 'inflatable-slide', 'inflatable-obstacle-course'],
  'Buying Guide': ['bounce-house', 'bounce-house-combo', 'inflatable-slide', 'inflatable-obstacle-course'],
  'Sourcing': ['bounce-house-combo', 'inflatable-obstacle-course', 'inflatable-tent'],
  'Compliance': ['bounce-house', 'inflatable-slide', 'inflatable-water-park'],
  'Materials': ['bounce-house', 'inflatable-slide', 'inflatable-tent'],
  'Product Guide': ['inflatable-slide', 'inflatable-obstacle-course', 'inflatable-games'],
  'OEM / ODM': ['bounce-house-combo', 'inflatable-obstacle-course', 'inflatable-tent'],
  'Water Attractions': ['inflatable-water-park', 'inflatable-slide'],
  'Venue Planning': ['inflatable-games', 'inflatable-theme-park', 'inflatable-obstacle-course'],
  'Export': ['bounce-house-combo', 'inflatable-tent', 'inflatable-water-park'],
  'Operations': ['bounce-house', 'inflatable-slide', 'inflatable-games'],
  'Advertising': ['advertising-inflatable', 'inflatable-tent'],
};
const relatedCategorySlugs = categoryLinksByTopic[article.category] ?? ['bounce-house-combo', 'inflatable-slide', 'inflatable-games'];
const relatedCategories = relatedCategorySlugs
  .map((slug) => categories.find((category) => category.slug === slug))
  .filter((category): category is (typeof categories)[number] => Boolean(category));
const relatedProducts = (article.relatedProductSlugs ?? [])
  .map((slug) => products.find((product) => product.productSlug === slug))
  .filter((product): product is (typeof products)[number] => Boolean(product));
const relatedArticles = [
  ...blogArticles.filter((item) => item.slug !== article.slug && item.category === article.category),
  ...blogArticles.filter((item) => item.slug !== article.slug && item.category !== article.category),
].slice(0, 3);
const guideProfile = getBuyerGuideProfile(article.category);
const buyerFramework = article.buyerFramework ?? guideProfile;
const isRentalProcurementGuide = article.category === 'Rental Business' || /\b(?:rental|rentals|for rent|hire)\b/i.test([article.title, article.keywords, article.intro].join(' '));
const articleFaqs = article.faqs?.length ? article.faqs : [
  { question: 'What should a buyer confirm before acting on ' + displayTitle + '?', answer: guideProfile.decision },
  ...guideProfile.faqs,
];
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.description,
  inLanguage: article.language ?? 'en',
  datePublished: article.published,
  dateModified: article.updated ?? article.published,
  mainEntityOfPage: articleUrl,
  image: `https://${company.domain}${image}`,
  keywords: article.keywords,
  author: { '@type': 'Organization', name: company.name, url: `https://${company.domain}/about/` },
  publisher: { '@type': 'Organization', name: company.name, url: `https://${company.domain}/`, logo: { '@type': 'ImageObject', url: `https://${company.domain}/assets/yic-logo-128.webp` } },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: articleFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${company.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `https://${company.domain}/blog/` },
    { '@type': 'ListItem', position: 3, name: article.title, item: articleUrl },
  ],
};
---

<SiteLayout title={seoTitle(article.metaTitle ?? displayTitle, 'YIC')} description={article.description} image={image} imageAlt={imageAlt} ogType="article" publishedTime={article.published} modifiedTime={article.updated ?? article.published} keywords={article.keywords} lang={article.language ?? 'en'}>
  <article class="article-page">
    <header class="article-hero">
      <div class="container">
        <div class="breadcrumbs"><a href="/">{labels.home}</a> / <a href="/blog/">{labels.blog}</a> / {displayTitle}</div>
        <p class="eyebrow">{labels.categoryNames[article.category] ?? article.category} · {article.readTime}</p>
        <h1>{displayTitle}</h1>
        <p>{article.intro}</p>
        {isRentalProcurementGuide && <p class="article-procurement-note"><strong>{labels.rentalNote}</strong></p>}
        <div class="article-meta"><span>{labels.published} {article.published}</span>{article.updated && article.updated !== article.published && <span>{labels.updated} {article.updated}</span>}<span>{labels.resource}</span></div>
      </div>
    </header>

    <div class="container article-layout">
      <div class="article-content">
        {article.answer && <section class="article-direct-answer"><p class="eyebrow">{labels.quickAnswer}</p><p>{article.answer}</p></section>}
        <figure class:list={['article-feature-image', article.image?.fit === 'contain' && 'is-contained']}><img src={image} alt={imageAlt} width="1200" height="800" fetchpriority="high" />{imageCaption && <figcaption>{imageCaption}</figcaption>}</figure>
        {article.sections.length >= 4 && <nav class="article-toc" aria-label={labels.contents}><strong>{labels.contents}</strong><ol>{article.sections.map((section) => <li><a href={`#${sectionId(section.heading)}`}>{section.heading}</a></li>)}</ol></nav>}
        {article.sections.map((section) => <section id={sectionId(section.heading)}><h2>{section.heading}</h2><p>{section.body}</p></section>)}
        <section class="buyer-guide-module article-decision"><p class="eyebrow">{labels.decisionEyebrow}</p><h2>{labels.decisionTitle}</h2><p>{buyerFramework.decision}</p></section>
        <section class="buyer-guide-module"><p class="eyebrow">{labels.checklistEyebrow}</p><h2>{labels.checklistTitle}</h2><ul class="article-checklist">{buyerFramework.checklist.map((item) => <li>{item}</li>)}</ul></section>
        <section class="buyer-guide-module"><p class="eyebrow">{labels.risksEyebrow}</p><h2>{labels.risksTitle}</h2><div class="article-risk-grid">{buyerFramework.risks.map((risk, index) => <article><span>0{index + 1}</span><p>{risk}</p></article>)}</div></section>
        <section class="buyer-guide-module"><p class="eyebrow">{labels.questionsEyebrow}</p><h2>{labels.questionsTitle}</h2><ol class="article-question-list">{buyerFramework.factoryQuestions.map((question) => <li>{question}</li>)}</ol></section>
        <section class="article-faq-section"><p class="eyebrow">{labels.faqEyebrow}</p><h2>{displayTitle} FAQ</h2><div class="faq-list">{articleFaqs.map((faq) => <details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>
        <section><h2>{labels.exploreTitle}</h2><p>{labels.exploreBody}</p><div class="article-category-links">{relatedCategories.map((category) => <a href={categoryPath(category)}>{labels.categoryNames[category.name] ?? category.name} <span aria-hidden="true">→</span></a>)}</div></section>
        {relatedProducts.length > 0 && <section class="article-related-products"><h2>{labels.specsTitle}</h2><p>{labels.specsBody}</p><div>{relatedProducts.map((product) => <a href={productPath(product)}><strong>{product.title}</strong><span>{product.category} · {product.dimensions}</span><em>{labels.viewDetails}</em></a>)}</div></section>}
        {article.internalLinks?.length && <section class="article-resource-links"><h2>{labels.resourcesTitle}</h2><ul>{article.internalLinks.map((link) => <li><a href={link.href}>{link.label} →</a></li>)}</ul></section>}
        <section><h2>{labels.contactTitle}</h2><p>{labels.contactBody} <a href="/contact/">{labels.sendRequirements}</a> {labels.contactTail} <a href="/products/">{labels.browseCatalog}</a>.</p></section>
        <section class="related-articles"><p class="eyebrow">{labels.continue}</p><h2>{labels.relatedTitle}</h2><div>{relatedArticles.map((item) => <a href={`/blog/${item.slug}/`}><span>{labels.categoryNames[item.category] ?? item.category}</span><strong>{item.shortTitle ?? item.title}</strong><em>{labels.readGuide}</em></a>)}</div></section>
      </div>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</SiteLayout>
