---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { blogArticles, getBlogArticle } from '../../data/blog';
import { getBuyerGuideProfile } from '../../data/buyer-guides';
import { categories, categoryPath, company, products, productPath, seoTitle } from '../../data/site';

export function getStaticPaths() {
  return blogArticles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article: routeArticle } = Astro.props;
const article = routeArticle ?? getBlogArticle(Astro.params.slug ?? '');
if (!article) throw new Error('Blog article not found');

const imageProduct = article.imageProductSlug
  ? products.find((product) => product.productSlug === article.imageProductSlug)
  : undefined;
const image = article.image?.src ?? imageProduct?.images[0] ?? '/assets/commercial-inflatable-manufacturer-workshop-interior.webp';
const imageAlt = article.image?.alt ?? (imageProduct ? `${imageProduct.title} commercial inflatable product` : `YIC commercial inflatable guide: ${article.title}`);
const imageCaption = article.image?.caption;
const articleUrl = `https://${company.domain}/blog/${article.slug}/`;
const sectionId = (heading: string) => heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const categoryLinksByTopic: Record<string, string[]> = {
  'Rental Business': ['bounce-house', 'bounce-house-combo', 'inflatable-slide', 'inflatable-obstacle-course'],
  'Buying Guide': ['bounce-house', 'bounce-house-combo', 'inflatable-slide', 'inflatable-obstacle-course'],
  'Sourcing': ['bounce-house-combo', 'inflatable-obstacle-course', 'inflatable-tent'],
  'Compliance': ['bounce-house', 'inflatable-slide', 'inflatable-water-park'],
  'Materials': ['bounce-house', 'inflatable-slide', 'inflatable-tent'],
  'Product Guide': ['inflatable-slide', 'inflatable-obstacle-course', 'inflatable-games'],
  'OEM / ODM': ['advertising-inflatable', 'inflatable-tent', 'inflatable-theme-park'],
  'Water Attractions': ['inflatable-water-park', 'inflatable-slide'],
  'Venue Planning': ['inflatable-games', 'inflatable-theme-park', 'inflatable-obstacle-course'],
  'Export': ['bounce-house-combo', 'inflatable-tent', 'inflatable-water-park'],
  'Operations': ['bounce-house', 'inflatable-slide', 'inflatable-games'],
  'Advertising': ['advertising-inflatable', 'inflatable-tent'],
};
const relatedCategorySlugs = categoryLinksByTopic[article.category] ?? ['bounce-house-combo', 'inflatable-slide', 'inflatable-games'];
const relatedCategories = relatedCategorySlugs
  .map((slug) => categories.find((category) => category.slug === slug))
  .filter((category): category is (typeof categories)[number] => Boolean(category));
const relatedProducts = (article.relatedProductSlugs ?? [])
  .map((slug) => products.find((product) => product.productSlug === slug))
  .filter((product): product is (typeof products)[number] => Boolean(product));
const relatedArticles = [
  ...blogArticles.filter((item) => item.slug !== article.slug && item.category === article.category),
  ...blogArticles.filter((item) => item.slug !== article.slug && item.category !== article.category),
].slice(0, 3);
const guideProfile = getBuyerGuideProfile(article.category);
const buyerFramework = article.buyerFramework ?? guideProfile;
const isRentalProcurementGuide = article.category === 'Rental Business' || /\b(?:rental|rentals|for rent|hire)\b/i.test([article.title, article.keywords, article.intro].join(' '));
const articleFaqs = article.faqs?.length ? article.faqs : [
  { question: 'What should a buyer confirm before acting on ' + article.title + '?', answer: guideProfile.decision },
  ...guideProfile.faqs,
];
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.description,
  datePublished: article.published,
  dateModified: article.updated ?? article.published,
  mainEntityOfPage: articleUrl,
  image: `https://${company.domain}${image}`,
  keywords: article.keywords,
  author: { '@type': 'Organization', name: company.name, url: `https://${company.domain}/about/` },
  publisher: { '@type': 'Organization', name: company.name, url: `https://${company.domain}/`, logo: { '@type': 'ImageObject', url: `https://${company.domain}/assets/yic-logo-128.webp` } },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: articleFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://${company.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `https://${company.domain}/blog/` },
    { '@type': 'ListItem', position: 3, name: article.title, item: articleUrl },
  ],
};
---

<SiteLayout title={seoTitle(article.metaTitle ?? article.title, 'YIC')} description={article.description} image={image} imageAlt={imageAlt} ogType="article" publishedTime={article.published} modifiedTime={article.updated ?? article.published} keywords={article.keywords}>
  <article class="article-page">
    <header class="article-hero">
      <div class="container">
        <div class="breadcrumbs"><a href="/">Home</a> / <a href="/blog/">Blog</a> / {article.title}</div>
        <p class="eyebrow">{article.category} · {article.readTime}</p>
        <h1>{article.title}</h1>
        <p>{article.intro}</p>
        {isRentalProcurementGuide && <p class="article-procurement-note"><strong>Commercial procurement note:</strong> This guide is for operators and distributors buying equipment for a fleet or venue. YIC is a factory-direct manufacturer, not a local consumer rental service.</p>}
        <div class="article-meta"><span>Published {article.published}</span>{article.updated && article.updated !== article.published && <span>Updated {article.updated}</span>}<span>YIC Inflatable Sports buyer resource</span></div>
      </div>
    </header>

    <div class="container article-layout">
      <div class="article-content">
        {article.answer && <section class="article-direct-answer"><p class="eyebrow">Quick answer</p><p>{article.answer}</p></section>}
        <figure class:list={['article-feature-image', article.image?.fit === 'contain' && 'is-contained']}><img src={image} alt={imageAlt} width="1200" height="800" fetchpriority="high" />{imageCaption && <figcaption>{imageCaption}</figcaption>}</figure>
        {article.sections.length >= 4 && <nav class="article-toc" aria-label="Article contents"><strong>In this guide</strong><ol>{article.sections.map((section) => <li><a href={`#${sectionId(section.heading)}`}>{section.heading}</a></li>)}</ol></nav>}
        {article.sections.map((section) => <section id={sectionId(section.heading)}><h2>{section.heading}</h2><p>{section.body}</p></section>)}
        <section class="buyer-guide-module article-decision"><p class="eyebrow">Decision before quotation</p><h2>What this guide means for a commercial buyer</h2><p>{buyerFramework.decision}</p></section>
        <section class="buyer-guide-module"><p class="eyebrow">Buyer checklist</p><h2>Information to confirm before comparing suppliers</h2><ul class="article-checklist">{buyerFramework.checklist.map((item) => <li>{item}</li>)}</ul></section>
        <section class="buyer-guide-module"><p class="eyebrow">Risk control</p><h2>Common mistakes to avoid</h2><div class="article-risk-grid">{buyerFramework.risks.map((risk, index) => <article><span>0{index + 1}</span><p>{risk}</p></article>)}</div></section>
        <section class="buyer-guide-module"><p class="eyebrow">Factory conversation</p><h2>Questions to send before the order is released</h2><ol class="article-question-list">{buyerFramework.factoryQuestions.map((question) => <li>{question}</li>)}</ol></section>
        <section class="article-faq-section"><p class="eyebrow">Buyer FAQ</p><h2>{article.title} FAQ</h2><div class="faq-list">{articleFaqs.map((faq) => <details class="faq-item"><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>
        <section><h2>Explore relevant commercial inflatables</h2><p>Compare the product categories that relate to this buying guide, then send YIC the models, quantity, destination, and customization details you want quoted.</p><div class="article-category-links">{relatedCategories.map((category) => <a href={categoryPath(category)}>{category.name} <span aria-hidden="true">→</span></a>)}</div></section>
        {relatedProducts.length > 0 && <section class="article-related-products"><h2>Related product specifications</h2><p>These catalog models give buyers a concrete starting point. Confirm the final size, components, material, and order scope against the quotation.</p><div>{relatedProducts.map((product) => <a href={productPath(product)}><strong>{product.title}</strong><span>{product.category} · {product.dimensions}</span><em>View product details →</em></a>)}</div></section>}
        {article.internalLinks?.length && <section class="article-resource-links"><h2>Related buyer resources</h2><ul>{article.internalLinks.map((link) => <li><a href={link.href}>{link.label} →</a></li>)}</ul></section>}
        <section><h2>Talk with a commercial inflatable manufacturer</h2><p>Have a product list, custom idea, or venue plan? <a href="/contact/">Send your requirements to YIC</a> and include the destination market, quantity, dimensions, artwork, and target delivery date. You can also <a href="/products/">browse the commercial product catalog</a> before requesting a quote.</p></section>
        <section class="related-articles"><p class="eyebrow">Continue learning</p><h2>Related buyer guides</h2><div>{relatedArticles.map((item) => <a href={`/blog/${item.slug}/`}><span>{item.category}</span><strong>{item.title}</strong><em>Read guide →</em></a>)}</div></section>
      </div>
      <aside class="article-aside">
        <div class="article-aside-card"><img src="/assets/commercial-inflatable-manufacturer-workshop-interior.webp" alt="YIC commercial inflatable factory and workshop" loading="lazy" width="900" height="720" /><strong>Need a product recommendation?</strong><p>Tell us what you are planning to buy and where it will be used.</p><a class="button button-small" href="/contact/">Request a factory quote</a></div>
        <div class="article-aside-links"><strong>Explore more</strong><a href="/products/">Commercial product catalog →</a><a href="/factory-evidence/">Factory evidence →</a><a href="/about/">Factory and quality →</a><a href="/faq/">Buyer FAQ →</a></div>
      </aside>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</SiteLayout>
