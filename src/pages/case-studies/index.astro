---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { caseStudies, caseStudyCards, selectedCaseStudies, unmatchedBuyerReferences } from '../../data/case-studies';
import { company } from '../../data/site';

const title = 'Commercial Inflatable Project Examples | YIC';
const description = 'Explore selected commercial inflatable project examples across bounce houses, slides, obstacle courses, water attractions, tents, games, and custom event installations.';
const filterOptions = [
  { key: 'all', label: 'All projects' },
  { key: 'bounce-slide', label: 'Bounce & slide' },
  { key: 'games-obstacle', label: 'Games & obstacle' },
  { key: 'water-park', label: 'Water & park' },
  { key: 'events-branding', label: 'Events & branding' },
];
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: `https://${company.domain}/case-studies/`,
  isPartOf: { '@id': `https://${company.domain}/#website` },
  about: { '@id': `https://${company.domain}/#organization` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: caseStudies.map((caseStudy, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${caseStudy.title} · ${caseStudy.country}`,
    })),
  },
};
---

<SiteLayout title={title} description={description} image={selectedCaseStudies[0].image} imageAlt={selectedCaseStudies[0].alt} keywords="commercial inflatable project examples, inflatable manufacturer case studies, bounce house project, inflatable slide project, OEM inflatable manufacturer">
  <section class="page-hero case-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Project examples</div><p class="eyebrow">Commercial projects · Global B2B buyers</p><h1>Commercial Inflatable Project Examples</h1><p>Explore selected project images across commercial bounce houses, slides, obstacle courses, water attractions, event structures, and custom activity products. Buyer references are shown only where the customer identifier has been partially obscured for commercial privacy.</p></div></section>

  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Selected work</p><h2>Project Images Across Products and Markets</h2></div><p>Every example is organized by the product format, country or market stated with the image, and the commercial application it represents. Discuss a similar configuration directly with the factory.</p></div><div class="case-feature-grid">{selectedCaseStudies.map((caseStudy) => <article class="case-feature"><img src={caseStudy.image} alt={caseStudy.alt} loading="lazy" width="960" height="720" /><div><p>{caseStudy.country}</p><h2>{caseStudy.title}</h2><span>{caseStudy.productType} · {caseStudy.application}</span></div></article>)}</div></div></section>

  <section class="section section-muted"><div class="container"><div class="section-heading"><div><p class="eyebrow">Project gallery</p><h2>Browse by Commercial Application</h2></div><p>Filter by product type. Where supplied, the country-specific customer reference is shown above the related project information.</p></div><div class="case-filters" data-case-filters aria-label="Filter project examples">{filterOptions.map((filter, index) => <button type="button" class:list:active={index === 0} data-case-filter={filter.key} aria-pressed={index === 0 ? 'true' : 'false'}>{filter.label}</button>)}</div><div class="case-grid" data-case-grid>{caseStudyCards.map((caseStudy) => <article class="case-card" data-case-segment={caseStudy.segment}><img src={caseStudy.image} alt={caseStudy.alt} loading="lazy" width="960" height="720" /><div class="case-card-copy">{caseStudy.buyerReference && <figure class="case-buyer-reference"><img src={caseStudy.buyerReference.image} alt={`Flag and partially obscured customer name for ${caseStudy.country}`} loading="lazy" width="102" height="74" /></figure>}<p class="case-country">{caseStudy.country}</p><h3>{caseStudy.title}</h3><p>{caseStudy.productType}</p><span>{caseStudy.application}</span><a class="text-link" href={`/contact/?product=${encodeURIComponent(caseStudy.productType)}&source=/case-studies/`}>Discuss a similar project →</a></div></article>)}</div></div></section>

  {unmatchedBuyerReferences.length > 0 && <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Buyer references</p><h2>Additional Buyer References</h2></div><p>Customer-reference images without a matching project photo in this gallery are shown separately.</p></div><div class="buyer-reference-grid buyer-reference-grid-single">{unmatchedBuyerReferences.map((reference) => <figure class="buyer-reference"><img src={reference.image} alt={`Flag and partially obscured customer name for ${reference.country}`} loading="lazy" width="111" height="72" /><figcaption>{reference.country}</figcaption></figure>)}</div></div></section>}

  <section class="cta-band"><div class="container cta-band-inner"><div><p class="eyebrow">Similar project</p><h2>Planning a Commercial Inflatable Project?</h2><p>Send your category, available space, quantity, theme or artwork, target market, and delivery timing for a factory discussion.</p></div><a class="button button-secondary" href="/contact/?source=/case-studies/">Request a factory quote</a></div></section>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)}></script>
  <script>
    const filterButtons = Array.from(document.querySelectorAll('[data-case-filter]'));
    const projectCards = Array.from(document.querySelectorAll('[data-case-segment]'));
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-case-filter') || 'all';
        filterButtons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle('active', active);
          candidate.setAttribute('aria-pressed', String(active));
        });
        projectCards.forEach((card) => {
          const show = filter === 'all' || card.getAttribute('data-case-segment') === filter;
          card.toggleAttribute('hidden', !show);
        });
      });
    });
  </script>
</SiteLayout>
