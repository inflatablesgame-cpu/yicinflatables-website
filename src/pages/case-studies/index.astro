---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { caseStudies, caseStudyCards, selectedCaseStudies, unmatchedBuyerReferences } from '../../data/case-studies';
import { categories, company, products, categoryPath, productPath } from '../../data/site';

const title = 'Commercial Inflatable Case Studies & Projects | YIC';
const description = 'Browse global commercial inflatable projects: bounce houses, slides, obstacle courses, sports games and event tents, with related products and B2B planning notes.';
const origin = `https://${company.domain}`;
const relatedProductFor = (caseStudy: (typeof caseStudies)[number]) => caseStudy.relatedProductSlug
  ? products.find((product) => product.productSlug === caseStudy.relatedProductSlug)
  : undefined;
const relatedCategoryFor = (caseStudy: (typeof caseStudies)[number]) => caseStudy.relatedCategorySlug
  ? categories.find((category) => category.slug === caseStudy.relatedCategorySlug)
  : undefined;
const relatedLinkFor = (caseStudy: (typeof caseStudies)[number]) => {
  const product = relatedProductFor(caseStudy);
  if (caseStudy.relatedProductSlug && !product) throw new Error(`Related product not found for case study: ${caseStudy.id}`);
  const category = relatedCategoryFor(caseStudy);
  if (!product && !category) throw new Error(`Related product or category missing for case study: ${caseStudy.id}`);
  return product
    ? { href: productPath(product), label: 'View related product', name: product.title, url: `${origin}${productPath(product)}` }
    : { href: categoryPath(category!), label: 'Browse related products', name: `${category!.name} products`, url: `${origin}${categoryPath(category!)}` };
};
const projectCards = caseStudyCards.map((caseStudy) => ({ ...caseStudy, relatedLink: relatedLinkFor(caseStudy) }));
const filterOptions = [
  { key: 'all', label: 'All projects' },
  { key: 'bounce-slide', label: 'Bounce & slide' },
  { key: 'games-obstacle', label: 'Games & obstacle' },
  { key: 'water-park', label: 'Water & park' },
  { key: 'events-branding', label: 'Events & branding' },
];
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: `https://${company.domain}/case-studies/`,
  isPartOf: { '@id': `https://${company.domain}/#website` },
  about: { '@id': `https://${company.domain}/#organization` },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projectCards.map((caseStudy, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'CreativeWork',
        '@id': `${origin}/case-studies/#${caseStudy.id}`,
        name: `${caseStudy.title} · ${caseStudy.country}`,
        description: caseStudy.description,
        image: `${origin}${caseStudy.image}`,
        url: `${origin}/case-studies/#${caseStudy.id}`,
        about: { '@type': 'Thing', name: caseStudy.relatedLink.name, url: caseStudy.relatedLink.url },
      },
    })),
  },
};
---

<SiteLayout title={title} description={description} image={selectedCaseStudies[0].image} imageAlt={selectedCaseStudies[0].alt} keywords="commercial inflatable case studies, inflatable project examples, bounce house projects, inflatable water slide projects, obstacle course projects, inflatable games, inflatable event tents, OEM inflatable manufacturer">
  <section class="page-hero case-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Project examples</div><p class="eyebrow">Commercial projects · Global B2B buyers</p><h1>Commercial Inflatable Case Studies</h1><p>Review project photos from buyers and event settings across Argentina, Austria, Brazil, Croatia, France, Germany, Peru, the Philippines, South Africa, Sri Lanka, the United Arab Emirates, the United Kingdom and the United States. Explore bounce houses, water slides, obstacle courses, sports games, promotional inflatables and event tents, then follow each project to a related catalog product or category.</p><p>Descriptions focus on visible product features and practical purchasing questions. Use the project links to compare a related model; confirm final dimensions, materials, artwork, accessories and operating requirements for your own order.</p></div></section>

  <section class="section section-muted"><div class="container"><div class="section-heading"><div><p class="eyebrow">Project gallery</p><h2>Project Details by Product and Application</h2></div><p>Filter by product type. Each entry describes the visible configuration, its stated market context and the main checks a B2B buyer should make before requesting a quote. Customer-reference images appear only where supplied for that project.</p></div><div class="case-filters" data-case-filters aria-label="Filter project examples">{filterOptions.map((filter, index) => <button type="button" class:list:active={index === 0} data-case-filter={filter.key} aria-pressed={index === 0 ? 'true' : 'false'}>{filter.label}</button>)}</div><div class="case-grid" data-case-grid>{projectCards.map((caseStudy) => <article class="case-card" id={caseStudy.id} data-case-segment={caseStudy.segment}><img src={caseStudy.image} alt={caseStudy.alt} loading="lazy" width="960" height="720" /><div class="case-card-copy">{caseStudy.buyerReference && <figure class="case-buyer-reference"><img src={caseStudy.buyerReference.image} alt={`Flag and partially obscured customer name for ${caseStudy.country}`} loading="lazy" width="102" height="74" /></figure>}<p class="case-country">{caseStudy.country}</p><h3>{caseStudy.title}</h3><p class="case-product-type">{caseStudy.productType}</p><span>{caseStudy.application}</span><p class="case-detail-copy">{caseStudy.description}</p><p class="case-buyer-focus"><strong>Buyer planning:</strong> {caseStudy.buyerFocus}</p><div class="case-card-actions"><a class="text-link" href={caseStudy.relatedLink.href}>{caseStudy.relatedLink.label} →</a><a class="text-link" href={`/contact/?product=${encodeURIComponent(caseStudy.productType)}&source=${encodeURIComponent(`/case-studies/#${caseStudy.id}`)}`}>Discuss a similar project →</a></div></div></article>)}</div></div></section>

  {unmatchedBuyerReferences.length > 0 && <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Buyer references</p><h2>Additional Buyer References</h2></div><p>Customer-reference images without a matching project photo in this gallery are shown separately.</p></div><div class="buyer-reference-grid buyer-reference-grid-single">{unmatchedBuyerReferences.map((reference) => <figure class="buyer-reference"><img src={reference.image} alt={`Flag and partially obscured customer name for ${reference.country}`} loading="lazy" width="111" height="72" /><figcaption>{reference.country}</figcaption></figure>)}</div></div></section>}

  <section class="cta-band"><div class="container cta-band-inner"><div><p class="eyebrow">Similar project</p><h2>Planning a Commercial Inflatable Project?</h2><p>Send your category, available space, quantity, theme or artwork, target market, and delivery timing for a factory discussion.</p></div><a class="button button-secondary" href="/contact/?source=/case-studies/">Request a factory quote</a></div></section>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)}></script>
  <script>
    const filterButtons = Array.from(document.querySelectorAll('[data-case-filter]'));
    const projectCards = Array.from(document.querySelectorAll('[data-case-segment]'));
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-case-filter') || 'all';
        filterButtons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle('active', active);
          candidate.setAttribute('aria-pressed', String(active));
        });
        projectCards.forEach((card) => {
          const show = filter === 'all' || card.getAttribute('data-case-segment') === filter;
          card.toggleAttribute('hidden', !show);
        });
      });
    });
  </script>
</SiteLayout>
