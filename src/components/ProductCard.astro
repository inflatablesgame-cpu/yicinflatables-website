---
import { company, productCardDescription, productCardImage, productCardLabel, productDetailContent, productHeadingTitle, productPath, productPrimaryKeyword, sanitizeB2BCopy } from '../data/site';
import type { Product } from '../data/site';

interface Props {
  product: Product;
  variant?: 'default' | 'selector';
}

const { product, variant = 'default' } = Astro.props;
const displayTitle = productHeadingTitle(product);
const imageLabel = product.category === 'Bounce House' || product.category === 'Bounce House Combo'
  ? productPrimaryKeyword(product)
  : displayTitle;
const url = productPath(product);
const detail = productDetailContent(product);
const applications = sanitizeB2BCopy(product, detail.applications.slice(0, 2).map((application) => application.title).join(' · ') || detail.primaryBuyer);
const cardDescription = sanitizeB2BCopy(product, productCardDescription(product));
const cardLabel = sanitizeB2BCopy(product, productCardLabel(product));
// The quote should identify the page where the buyer clicked the card
// (home, product hub, category, or related-products section), not silently
// replace it with the destination product URL.
const sourcePageUrl = new URL(Astro.url.pathname, `https://${company.domain}`).href;
---

<article class="product-card" data-product-card data-product-url={url}>
  <a class="product-card-image" href={url}>
    <img src={productCardImage(product)} alt={imageLabel} loading="lazy" decoding="async" width="720" height="540" />
    <span class="image-label">View product</span>
  </a>
  <div class="product-card-body">
    <p class="eyebrow">{product.category}</p>
    <h3><a href={url}>{displayTitle}</a></h3>
    {variant === 'selector' ? (
      <dl class="product-selector-meta">
        <div><dt>Application</dt><dd>{applications}</dd></div>
        <div><dt>Reference size</dt><dd>{product.dimensions || 'Custom dimensions'}</dd></div>
        <div><dt>Customization</dt><dd>Custom artwork &amp; dimensions · OEM/ODM</dd></div>
      </dl>
    ) : (
      <>
        <p class="product-card-description">{cardDescription}</p>
        <small class="product-card-material">{cardLabel}</small>
      </>
    )}
    <div class="card-actions"><a href={url}>View details</a><a href={`/contact/?product=${encodeURIComponent(displayTitle)}&source=${encodeURIComponent(sourcePageUrl)}`}>Get quote</a></div>
  </div>
</article>
