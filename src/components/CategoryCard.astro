---
import { categoryImageAlt, categoryPath, productCardImage, type Category } from '../data/site';

interface Props {
  category: Category;
  image?: string;
  imageAlt?: string;
}

const { category, image, imageAlt } = Astro.props;
const accessibleImageAlt = imageAlt ?? categoryImageAlt(category);
const cardImage = productCardImage({ images: [image ?? category.heroImage] });
const mobileCardImage = image ? undefined : `/assets/optimized/category-cards/${category.slug}.webp`;
---

<a class="category-card" href={categoryPath(category)} aria-label={`Browse ${category.name}, ${category.count} products`}>
  <picture>{mobileCardImage && <source media="(max-width: 700px)" srcset={mobileCardImage} type="image/webp" />}<img src={cardImage} alt={accessibleImageAlt} loading="lazy" decoding="async" width="720" height="540" sizes="(max-width: 700px) 50vw, 25vw" /></picture>
  <span class="category-card-overlay"></span>
  <span class="category-card-content"><strong>{category.name}</strong><small>Commercial · OEM/ODM · View category →</small></span>
</a>
