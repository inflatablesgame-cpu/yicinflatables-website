---
import { productCardImage, type Category } from '../data/site';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const cardImage = productCardImage({ images: [category.heroImage] });
---

<a class="category-card" href={`/products/${category.slug}/`} aria-label={`Browse ${category.name}, ${category.count} products`}>
  <img src={cardImage} alt={category.name} loading="lazy" decoding="async" width="720" height="540" />
  <span class="category-card-overlay"></span>
  <span class="category-card-content"><strong>{category.name}</strong><small>Commercial · OEM/ODM · View category →</small></span>
</a>
