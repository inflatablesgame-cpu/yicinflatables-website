{
  "name": "b2b-astro-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "verify:images": "node scripts/verify-product-images.mjs",
    "verify:seo-geo": "node --experimental-strip-types scripts/verify-seo-geo.mjs",
    "build": "npm run verify:images && npm run verify:seo-geo && astro build",
    "preview": "astro preview",
    "sync:assets": "node scripts/sync-assets.mjs",
    "optimize:images": "node scripts/optimize-page-images.mjs",
    "optimize:case-studies": "node scripts/optimize-case-studies.mjs",
    "build:site": "npm run sync:assets && astro build"
  },
  "dependencies": {
    "astro": "latest"
  }
}
